---
import Header from "../components/Header.astro";
import HeaderAlternatif from "../components/HeaderAlternatif.astro";
import Footer from "../components/Footer.astro"
import { ClientRouter } from 'astro:transitions';
import '../styles/style.less';
import PageTransition from '../components/PageTransition.astro';
import CustomCursor from '../components/CustomCursor.astro';
import SEO from '../components/SEO.astro';

interface BreadcrumbItem {
	name: string;
	path: string;
}

interface ProjectData {
	title: string;
	description: string;
	clientName?: string;
	clientCompany?: string;
	year?: number;
	tags?: string[];
	link?: string;
}

interface Props {
	titre: string;
	description?: string;
	image?: string;
	imageAlt?: string;
	masquerFooter?: boolean;
	typeHeader?: 'normal' | 'alternatif';
	article?: boolean;
	publishedTime?: string | Date;
	tags?: string[];
	noindex?: boolean;
	schemaType?: 'WebPage' | 'WebSite' | 'AboutPage' | 'ContactPage' | 'CollectionPage' | 'CreativeWork';
	breadcrumb?: BreadcrumbItem[];
	projectData?: ProjectData;
}

const {
	titre,
	description = "Portfolio de Clément Torchiat : Directeur Artistique, UX/UI Designer & Développeur Web. Conception d'expériences digitales créatives, immersives et sur-mesure.",
	image = "/og-image.png",
	imageAlt,
	masquerFooter = false,
	typeHeader = 'normal',
	article = false,
	publishedTime,
	tags,
	noindex = false,
	schemaType = 'WebPage',
	breadcrumb = [],
	projectData
} = Astro.props;
---

<!doctype html>
<html lang="fr">
<head>
	<meta charset="utf-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="generator" content={Astro.generator} />
	
	<!-- SEO & Métadonnées complètes -->
	<SEO 
		titre={titre}
		description={description}
		image={image}
		imageAlt={imageAlt}
		article={article}
		publishedTime={publishedTime}
		tags={tags}
		noindex={noindex}
		schemaType={schemaType}
		breadcrumb={breadcrumb}
		projectData={projectData}
	/>
	
	<!-- Font Preloading -->
	<link rel="preload" href="/fonts/voyage-regular.otf" as="font" type="font/otf" crossorigin="anonymous" />
	<link rel="preload" href="/fonts/OTJubilee-SapphireMedium.otf" as="font" type="font/otf" crossorigin="anonymous" />
	<link rel="preload" href="/fonts/Switzer-Regular.woff2" as="font" type="font/woff2" crossorigin="anonymous" />
	<link rel="preload" href="/fonts/Switzer-Medium.woff2" as="font" type="font/woff2" crossorigin="anonymous" />

	<ClientRouter />
</head>
	<body>
		<PageTransition />
		{typeHeader === 'alternatif' ? <HeaderAlternatif /> : <Header />}
		<main>
			<slot />
		</main>
		{!masquerFooter && <Footer />}
		<CustomCursor />
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>