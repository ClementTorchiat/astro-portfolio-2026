---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';

import palette1 from '../assets/images/palette-1-1.webp';
import palette2 from '../assets/images/palette-1-2.webp';
import palette3 from '../assets/images/palette-1-3.webp';
import palette4 from '../assets/images/palette-1-4.webp';

import lofiVideo from '../assets/projects/lofi-coffee-video.webm';
import minimumVideo from '../assets/projects/minimum-video.webm';
import guobaVideo from '../assets/projects/guoba-video.webm';

const projetsBruts = await getCollection('projets');
const projets = projetsBruts.sort((a, b) => a.data.order - b.data.order);

const projectVideos: Record<string, string> = {
	'lofi-coffee': lofiVideo,
	'minimum': minimumVideo,
	'guoba': guobaVideo,
};
---

<Layout 
	titre="Clément Torchiat: Directeur artistique & Développeur web" 
	description="Je suis Clément. En alliant design d'interface et ingénierie web, je donne vie à des expériences digitales pensées pour connecter profondément les utilisateurs à votre univers."
	masquerFooter={false} 
	typeHeader="normal">
	<section id="hero">
		<div class="hero-background-image"></div>
		<div class="hero-title">
			<h1>Concevoir</h1>
			<h1>Coder</h1>
			<h1>Sublimer</h1>
		</div>
		<div class="hero-bottom-container">
			<div class="hero-line"></div>
			<div class="hero-bottom-background-gradient"></div>
			<div class="hero-bottom">
				<div class="hero-bottom-left">
					<p>Directeur artistique</p>
				</div>
				<div class="hero-bottom-center">
					<p>Je suis un designer passionné qui façonne méticuleusement des expériences numériques d'une qualité et d'un impact inégalés.</p>
				</div>
				<div class="hero-bottom-right">
					<p>Développeur web</p>
				</div>
			</div>
		</div>
	</section>
	<section id="about">
		<div class="about-container">
			<p class="grey-subtitle">(À propos)</p>
			<p class="about-description">Je suis Clément. En alliant design d'interface et ingénierie web, je donne vie à des expériences digitales pensées pour connecter profondément les utilisateurs à votre univers.</p>
		</div>
	</section>
	<section id="work">
		<div class="work-title-container">
			<div class="work-title-flex">
				<h2>Projets phares</h2>
				<p>(01)</p>
			</div>
			<div class="work-line"></div>
		</div>
		<div class="work-projects-container">
			<div class="work-projects-up">
				<div class="project-wrapper">
					<a href={`/projets/${projets[0].id}`} class="project-image" data-cursor-text="Voir le projet">
						<div class="video-container">
							<video class="video" src={projectVideos[projets[0].id]} loop muted playsinline preload="auto"></video>
						</div>
						<div class="image-split" style={`background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url(${projets[0].data.coverImage.src});`}></div>
						<div class="blurred-background"></div>
					</a>
					<div class="project-info">
						<h3><a href={`/projets/${projets[0].id}`} data-cursor-hover>{projets[0].data.title}</a></h3>
						<p class="project-roles">{projets[0].data.tags.join(', ')}</p>
					</div>
				</div>
				<div class="project-wrapper">
					<a href={`/projets/${projets[1].id}`} class="project-image" data-cursor-text="Voir le projet">
						<div class="video-container">
							<video class="video" src={projectVideos[projets[1].id]} loop muted playsinline preload="auto"></video>
						</div>
						<div class="image-split" style={`background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url(${projets[1].data.coverImage.src});`}></div>
						<div class="blurred-background"></div>
					</a>
					<div class="project-info">
						<h3><a href={`/projets/${projets[1].id}`} data-cursor-hover>{projets[1].data.title}</a></h3>
						<p class="project-roles">{projets[1].data.tags.join(', ')}</p>
					</div>
				</div>
			</div>
			<div class="work-projects-down">
				<div class="project-space"></div>
				<div class="project-wrapper">
					<a href={`/projets/${projets[2].id}`} class="project-image" data-cursor-text="Voir le projet">
						<div class="video-container">
							<video class="video" src={projectVideos[projets[2].id]} loop muted playsinline preload="auto"></video>
						</div>
						<div class="image-split" style={`background-image: linear-gradient(rgba(0, 0, 0, 0.1), rgba(0, 0, 0, 0.1)), url(${projets[2].data.coverImage.src});`}></div>
						<div class="blurred-background"></div>
					</a>
					<div class="project-info">
						<h3><a href={`/projets/${projets[2].id}`} data-cursor-hover>{projets[2].data.title}</a></h3>
						<p class="project-roles">{projets[2].data.tags.join(', ')}</p>
					</div>
				</div>
				<a href="/work" class="button-dot" data-cursor-hover>
					<div class="text-wrapper">
						<span class="original-text">Voir les projets</span>
						<span class="hover-text">Voir les projets</span>
					</div>
					<div class="liquid-bg"></div>
				</a>
			</div>
		</div>
	</section>
	<section id="palette">
		<div class="palette-title-container">
			<div class="palette-title-flex">
				<h2>Ma palette</h2>
				<p>(02)</p>
			</div>
		</div>
		<div class="palette-wrapper">
			<div class="palette-container">
				<div class="palette palette1">
					<div class="dark-overlay-palette"></div>
					<h3 class="palette-title">Direction artistique</h3>
					<div class="palette-image"></div>
					<div class="palette-bg-images">
						<Image src={palette1} alt="" />
						<Image src={palette2} alt="" />
						<Image src={palette3} alt="" />
						<Image src={palette4} alt="" />
					</div>
					<div class="palette-details-wrapper">
						<div class="palette-details-container">
							<div class="dark-overlay-palette"></div>
							<div class="palette-details">
								<p>Identité visuelle</p>
							</div>
							<div class="palette-details">
								<p>Direction créative</p>
							</div>
							<div class="palette-details">
								<p>Typographies et couleurs</p>
							</div>
							<div class="palette-details">
								<p>Charte graphique</p>
							</div>
							<div class="palette-details">
								<p>Raffinement de concept</p>
							</div>
						</div>
					</div>
				</div>
				<div class="palette palette2">
					<div class="dark-overlay-palette"></div>
					<h3 class="palette-title">Design UX/UI</h3>
					<div class="palette-image"></div>
					<div class="palette-bg-ui">
						<div class="ui-layer layer-1"></div>
						<div class="ui-layer layer-2">
							<div class="ui-skeleton header"></div>
							<div class="ui-skeleton body"></div>
						</div>
						<div class="ui-layer layer-3">
							<div class="ui-skeleton card"></div>
							<div class="ui-skeleton button"></div>
						</div>
					</div>
					<div class="palette-details-wrapper">
						<div class="palette-details-container">
							<div class="dark-overlay-palette"></div>
							<div class="palette-details">
								<p>Design de sites et d’apps</p>
							</div>
							<div class="palette-details">
								<p>Storytelling visuel</p>
							</div>
							<div class="palette-details">
								<p>Prototypage interactif</p>
							</div>
							<div class="palette-details">
								<p>Wireframes et user flows</p>
							</div>
							<div class="palette-details">
								<p>Design system</p>
							</div>
						</div>
					</div>
				</div>
				<div class="palette palette3">
					<div class="dark-overlay-palette"></div>
					<h3 class="palette-title">Développement web</h3>
					<div class="palette-image"></div>
					<div class="palette-bg-dev">
						<div class="code-line"><span>import {"{"} Experience {"}"} from '@avenir';</span></div>
						<div class="code-line"><span>const designer = new DA();</span></div>
						<div class="code-line"><span>const developer = new Dev();</span></div>
						<div class="code-line"><span>&nbsp;</span></div>
						<div class="code-line"><span>function build(idea) {"{"}</span></div>
						<div class="code-line"><span>&nbsp;&nbsp;return designer.sublime(idea)</span></div>
						<div class="code-line"><span>&nbsp;&nbsp;&nbsp;&nbsp;.then(developer.code);</span></div>
						<div class="code-line"><span>{"}"}</span></div>
					</div>
					<div class="palette-details-wrapper">
						<div class="palette-details-container">
							<div class="dark-overlay-palette"></div>
							<div class="palette-details">
								<p>HTML/CSS/JS</p>
							</div>
							<div class="palette-details">
								<p>Astro</p>
							</div>
							<div class="palette-details">
								<p>Vue.js</p>
							</div>
							<div class="palette-details">
								<p>Headless CMS (Sanity/WP)</p>
							</div>
							<div class="palette-details">
								<p>Et plus...</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</section>
	<section class="scroll-container">
		<div class="bg-white"></div>
		<div class="text-layer text-back">
			<h1 class="text-initial">Dans un monde<br>bruyant et<br>monochrome</h1>
		</div>
		<div class="image-reveal"></div>
		<div class="text-layer text-front">
			<h1 class="text-final">Soyez<br><span>l'exception</span></h1>
		</div>
		<img src="https://images.unsplash.com/photo-1580106815433-a5b1d1d53d85?q=80&w=1740&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D" class="floating-blur blur-1" alt="Portrait 1">
		<img src="https://images.unsplash.com/photo-1506794778202-cad84cf45f1d?q=80&w=400&auto=format&fit=crop" class="floating-blur blur-2" alt="Portrait 2">
		<img src="https://images.unsplash.com/photo-1531746020798-e6953c6e8e04?q=80&w=400&auto=format&fit=crop" class="floating-blur blur-3" alt="Portrait 3">
	</section>
</Layout>

<style>
	#hero .hero-background-image {
		z-index: 9;
		background-image: url(../assets/images/hero-background-image.webp);
		background-position: 50%;
		background-size: cover;
		width: 100vw;
		height: 100vh;
		position: absolute;
		inset: 0;
	}

	#hero .hero-title {
		z-index: 11;
		cursor: default;
		width: 100%;
		height: 100vh;
		display: flex;
		flex-direction: column;
		justify-content: center;
		padding-bottom: 15vh;
		position: relative;
		box-sizing: border-box;
	}

	#hero .hero-title h1 {
		margin: 0;
		line-height: 1.1;
		font-weight: normal;
		font-size: 16vw;
	}

	#hero .hero-title h1:nth-child(1) { align-self: flex-start; margin-left: 10%; }
	#hero .hero-title h1:nth-child(2) { align-self: flex-end; margin-right: 10%; }
	#hero .hero-title h1:nth-child(3) { align-self: flex-start; margin-left: 15%; }

	#hero .hero-bottom-container {
		z-index: 11;
		flex-flow: column;
		justify-content: flex-start;
		align-items: center;
		width: 100%;
		padding-left: 20px;
		padding-right: 20px;
		display: flex;
		position: absolute;
		inset: auto 0 0;
	}

	#hero .hero-line {
		width: 100%;
		height: 1px;
		background-color: var(--white);
		color: var(--white);
		position: relative;
		inset: auto 0 0;
	}

	#hero .hero-bottom-background-gradient {
		position: absolute;
		bottom: 0;
		left: 0;
		right: 0;
		height: 145px;
		background: linear-gradient(to top, #7B513699, #7B513600);
		z-index: -1;
		pointer-events: none;
	}

	#hero .hero-bottom {
		justify-content: space-between;
		align-items: center;
		width: 100%;
		padding-top: 16px;
		padding-bottom: 24px;
		display: flex;
	}

	#hero .hero-bottom-left,
	#hero .hero-bottom-right { display: none; }

	#hero .hero-bottom-center {
		font-size: 15px;
		line-height: 1.2;
		text-align: center;
	}

	#hero .hero-bottom-center p { color: var(--white); }

	#about {
		z-index: 4;
		justify-content: center;
		align-items: center;
		width: 100vw;
		display: flex;
		position: relative;
		padding: 86px 20px 130px;
	}

	#about .about-container {
		width: 43em;
		flex-flow: column;
		justify-content: center;
		align-items: center;
		display: flex;
		overflow: hidden;
		text-align: center;
		gap: 15px;
	}

	#about .about-description {
		font-size: 1rem;
		line-height: 1.25;
	}

	#work {
		padding-left: 20px;
		padding-right: 20px;
		padding-bottom: 100px;
	}

	#work .work-title-flex {
		justify-content: space-between;
		align-items: flex-end;
		display: flex;
		padding-bottom: 20px;
	}

	#work .work-title-flex h2 { text-transform: uppercase; }
	#work .work-title-flex p { display: none; }

	#work .work-line {
		background-color: var(--light-grey);
		width: 100%;
		height: 1px;
		position: relative;
		inset: auto 0 0;
	}

	#work .work-projects-container {
		flex-flow: column;
		justify-content: center;
		padding-top: 20px;
		display: flex;
		align-items: flex-start;
		gap: 1rem;
	}

	#work .project-wrapper {
		cursor: pointer !important;
		width: 100%;
		height: 317px;
		margin-right: 0;
		padding-bottom: 1.4em;
		color: var(--black);
		text-decoration: none;
	}

	#work .project-wrapper a.project-image {
		height: 90%;
		cursor: pointer;
		justify-content: center;
		align-items: center;
		width: 100%;
		display: flex;
		position: relative;
		overflow: hidden;
		max-width: 100%;
	}
	.work-projects-up {
		width: 100%;
		display: flex;
		flex-direction: column;
		gap: 1rem;
	}

	.work-projects-down {
		width: 100%;
	}

	#work .video-container {
		position: absolute;
		z-index: 8;
		width: 70%;
		aspect-ratio: 16 / 9;
		top: 50%;
		left: 50%;
		opacity: 0;
		pointer-events: none;
		border-radius: 8px;
		overflow: hidden;
		box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
	}

	#work .video {
		width: 100%;
		height: 100%;
		object-fit: cover;
		display: block;
	}

	#work .image-split {
		z-index: 3;
		background-position: 0 0, 50%;
		background-repeat: repeat, no-repeat;
		background-size: auto, cover;
		justify-content: center;
		align-items: center;
		width: 100%;
		height: 100%;
		display: flex;
		position: absolute;
		inset: 0;
	}

	#work .blurred-background {
		position: absolute;
		inset: 0;
		z-index: 3;
		background-color: rgba(0, 0, 0, 0.3);
		backdrop-filter: blur(12px);
		-webkit-backdrop-filter: blur(12px);
		opacity: 0;
		pointer-events: none;
	}

	#work .project-info { margin-top: 4px; padding-top: 8px; }
	#work .project-info h3 a {
		font-family: inherit;
		font-size: inherit;
		font-weight: inherit;
		line-height: inherit;
		color: inherit;
	}
	#work .project-info p { margin-top: 5px; line-height: 1; }
	#work .button-dot { width: 50%; margin-top: 49px; margin-left: auto; margin-right: auto; }

	#palette .palette-title-container { padding-left: 20px; padding-right: 20px; }
	#palette .palette-title-flex { justify-content: space-between; align-items: flex-end; display: flex; padding-bottom: 20px; }
	#palette .palette-title-flex h2 { text-transform: uppercase; }
	#palette .palette-title-flex p { display: none; }

	.palette-wrapper {
		width: 100%;
		top: 0;
	}

	.palette-container {
		width: 100%;
		height: auto;
		display: flex;
		flex-direction: column;
	}

	.palette {
		flex-flow: column;
		justify-content: center;
		align-items: center;
		width: 100%;
		height: 60vh;
		min-height: 400px;
		display: flex;
		position: relative;
	}

	.dark-overlay-palette {
		z-index: 12;
		opacity: 0;
		background-image: linear-gradient(#00000080, #00000080);
		width: 100%;
		height: 100%;
		display: block;
		position: absolute;
		inset: 0;
	}

	.palette-title {
		z-index: 6;
		color: var(--white);
		text-transform: uppercase;
		font-size: 27px;
		line-height: 1;
		font-weight: 500;
		display: block;
		position: relative;
	}

	.palette-title-flex {
		padding-bottom: 32px !important;
	}

	.palette-title-flex p {
		font-family: Jubilee, serif;
		font-size: 64px;
		font-weight: 100;
		line-height: 1.4;
	}

	.palette-image {
		z-index: 2;
		background-position: 50%;
		background-repeat: no-repeat;
		background-size: cover;
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		background-color: var(--white);
	}

	.palette1 .palette-image {
		background-image: url(../assets/images/palette-1-bg.webp);
	}

	.palette2 .palette-image {
		background-image: url(../assets/images/palette-2-bg.webp);
	}

	.palette3 .palette-image {
		background-image: url(../assets/images/palette-3-bg.webp);
	}

	.palette-image::after {
		content: "";
		position: absolute;
		inset: 0;
		background-image: inherit;
		background-position: inherit;
		background-repeat: inherit;
		background-size: inherit;
		background-color: inherit;
		background-blend-mode: difference;
		opacity: 0;
		transition: opacity 0.5s ease;
	}

	.palette-bg-images {
		z-index: 3;
		width: 100%;
		height: 100%;
		position: absolute;
		inset: 0;
		overflow: hidden;
		display: none;
	}

	.palette-bg-images img {
		z-index: 20;
		display: inline-block;
		position: absolute;
		height: auto;
		object-fit: cover;
		opacity: 0;
		transition: transform 0.6s ease-out, opacity 0.6s ease-out;
	}

	.palette-bg-images img:first-child {
		width: 40%;
		top: -10%;
		left: -20%;
		transform: translate(-20%, -20%);
	}

	.palette-bg-images img:nth-child(2) {
		width: 26%;
		top: 20%;
		right: 2%;
		transform: translate(20%, -10%);
	}

	.palette-bg-images img:nth-child(3) {
		width: 43%;
		bottom: 20%;
		left: -9%;
		transform: translate(-20%, 20%);
	}

	.palette-bg-images img:nth-child(4) {
		width: 46%;
		bottom: 1%;
		right: -9%;
		transform: translate(20%, 20%);
	}

	.palette-details-wrapper {
		z-index: 3;
		flex-flow: column;
		width: 100%;
		height: auto;
		padding-top: 40px;
		padding-bottom: 30px;
		display: flex;
		position: absolute;
		inset: auto 0 0;
		background: linear-gradient(to top, #3A2214cc, #3A221400);
		opacity: 1;
		transition: opacity 0.3s ease;
	}

	.palette-details-container {
		z-index: 1;
		flex-flow: column;
		justify-content: flex-start;
		align-items: center;
		width: 100%;
		height: auto;
		padding-top: 0;
		display: flex;
		position: relative;
	}

	.palette-details {
		z-index: 5;
		margin-bottom: .5em;
		justify-content: center;
		align-items: center;
		display: flex;
		position: relative;
	}

	.palette-details p {
		font-size: 1em;
		line-height: 1.2;
		font-family: 'Switzer', sans-serif;
		font-weight: 400;
		color: var(--white);
		opacity: 1;
		transform: translate3d(0px, 0em, 0px) scale3d(1, 1, 1) rotateX(0deg) rotateY(0deg) rotateZ(0deg) skew(0deg, 0deg);
		transform-style: preserve-3d;
	}

	.scroll-container {
		position: relative;
		width: 100vw;
		height: 100vh;
		overflow: hidden;
		background-color: var(--white);
	}

	.image-reveal {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		z-index: 2;
		clip-path: circle(0% at 50% 50%);
		background-color: var(--light-beige);
		background-image: url('../assets/images/scroll-container-bg.webp');
		background-size: cover;
		background-position: center;
	}

	.text-layer {
		position: absolute;
		top: 0;
		left: 0;
		width: 100%;
		height: 100%;
		display: flex;
		align-items: center;
		justify-content: center;
		pointer-events: none;
	}

	.text-initial, .text-final {
		position: absolute;
