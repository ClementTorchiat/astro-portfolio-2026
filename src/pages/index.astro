</style>

<script>
	// @ts-nocheck
	import { gsap } from "gsap";
	import { ScrollTrigger } from "gsap/ScrollTrigger";
	import SplitType from "split-type";
	import Lenis from 'lenis';

	gsap.registerPlugin(ScrollTrigger, SplitType);

	const tl = gsap.timeline({
		scrollTrigger: {
			trigger: ".scroll-container",
			start: "top top",
			end: "+=1500",
			scrub: 1,
			pin: true
		}
	});

	tl.fromTo(".image-reveal",
		{
			clipPath: "circle(0% at 50% 50%)"
		},
		{
			clipPath: "circle(100% at 50% 50%)",
			duration: 2,
			ease: "none"
		}
	)
		.to(".text-initial", {
			opacity: 0,
			duration: 0.5
		}, "<")
		.to(".text-final", {
			opacity: 1,
			duration: 0.5
		}, "-=1.2");

	tl.to(".floating-blur", {
		y: -500,
		opacity: 0,
		duration: 1.5
	}, 0);

	document.addEventListener("astro:page-load", () => {
		const lenis = new Lenis();

		lenis.on('scroll', ScrollTrigger.update);

		gsap.ticker.add((time) => {
			lenis.raf(time * 1000);
		});

		gsap.ticker.lagSmoothing(0);
		const prepareSplitReveal = (element) => {
			if (!element || window.getComputedStyle(element.parentElement).display === 'none') return [];
			const split = new SplitType(element, { types: 'lines' });

			split.lines.forEach((el) => {
				const wrapper = document.createElement('div');
				wrapper.style.overflow = 'hidden';
				wrapper.style.display = 'block';
				el.parentNode.insertBefore(wrapper, el);
				wrapper.appendChild(el);
			});

			gsap.set(split.lines, { y: "100%" });
			return split.lines;
		};

		const heroTitles = document.querySelectorAll('#hero .hero-title h1');
		const heroLine = document.querySelector('.hero-line');
		const textCenter = document.querySelector('.hero-bottom-center p');
		const textLeft = document.querySelector('.hero-bottom-left p');
		const textRight = document.querySelector('.hero-bottom-right p');

		if (heroTitles.length > 0) {
			const splitHero = new SplitType(heroTitles, { types: 'chars' });
			gsap.set(splitHero.chars, { opacity: 0, x: 60, y: 60 });

			gsap.set(heroLine, { scaleX: 0, transformOrigin: "center" });

			const prepareLines = (element) => {
				if (!element || window.getComputedStyle(element.parentElement).display === 'none') return [];

				const split = new SplitType(element, { types: 'lines' });
				split.lines.forEach((el) => {
					const wrapper = document.createElement('div');
					wrapper.style.overflow = 'hidden';
					wrapper.style.display = 'block';
					el.parentNode.insertBefore(wrapper, el);
					wrapper.appendChild(el);
				});
				gsap.set(split.lines, { y: "100%" });
				return split.lines;
			};

			const linesCenter = prepareLines(textCenter);
			const linesSides = [
				...prepareLines(textLeft),
				...prepareLines(textRight)
			];

			const playHeroAnimation = () => {
				const tlHero = gsap.timeline();

				tlHero.to(splitHero.chars, {
					opacity: 1,
					x: 0,
					y: 0,
					duration: 1.2,
					ease: "power3.out",
					stagger: { amount: 1, from: "random" }
				}, 0)

					.to(heroLine, {
						scaleX: 1,
						duration: 2,
						ease: "power3.inOut"
					}, 0.3)

					.to(linesCenter, {
						y: "0%",
						duration: 0.6,
						stagger: 0.1,
						ease: "power3.out"
					}, 0.6)

					.to(linesSides, {
						y: "0%",
						duration: 0.6,
						stagger: 0.1,
						ease: "power3.out"
					}, 1.2);
			};

			const aboutSubtitle = document.querySelector('#about .grey-subtitle');
			const aboutDescription = document.querySelector('#about .about-description');

			if (aboutSubtitle && aboutDescription) {
				const linesSubtitle = prepareSplitReveal(aboutSubtitle);
				const linesDescription = prepareSplitReveal(aboutDescription);

				ScrollTrigger.create({
					trigger: "#about",
					start: "top 75%",
					onEnter: () => {
						const tlAbout = gsap.timeline();

						tlAbout.to(linesSubtitle, {
							y: "0%",
							duration: 0.6,
							ease: "power3.out"
						})

							.to(linesDescription, {
								y: "0%",
								duration: 0.8,
								stagger: 0.1,
								ease: "power3.out"
							}, "-=0.4");
					},
					once: true
				});
			}

			const workTitle = document.querySelector('#work .work-title-flex h2');
			const workNum = document.querySelector('#work .work-title-flex p');
			const workLine = document.querySelector('#work .work-line');
			const workProjects = document.querySelectorAll('#work .project-wrapper');
			const workBtn = document.querySelector('#work .button-dot');

			if (workTitle) {
				const linesWorkTitle = prepareSplitReveal(workTitle);
				const linesWorkNum = prepareSplitReveal(workNum);

				gsap.set(workLine, { scaleX: 0, transformOrigin: "left" });

				gsap.set(workProjects, { opacity: 0 });
				if (workBtn) gsap.set(workBtn, { opacity: 0 });

				ScrollTrigger.create({
					trigger: "#work",
					start: "top 75%",
					onEnter: () => {
						const tlWork = gsap.timeline();

						tlWork.to(linesWorkTitle, {
							y: "0%",
							duration: 0.6,
							ease: "power3.out"
						})

							.to(workLine, {
								scaleX: 1,
								duration: 1.2,
								ease: "power3.inOut"
							}, "-=0.2")

							.to(linesWorkNum, {
								y: "0%",
								duration: 0.6,
								ease: "power3.out"
							}, "-=0.5")

							.to([workProjects, workBtn], {
								opacity: 1,
								duration: 0.8,
								stagger: 0.1,
								ease: "power2.out"
							}, "-=0.2");
					},
					once: true
				});
			}

			const paletteTitle = document.querySelector('#palette .palette-title-flex h2');
			const paletteNum = document.querySelector('#palette .palette-title-flex p');
			const palettes = document.querySelectorAll('#palette .palette');

			if (paletteTitle) {
				const linesPaletteTitle = prepareSplitReveal(paletteTitle);
				const linesPaletteNum = prepareSplitReveal(paletteNum);
				gsap.set(palettes, { opacity: 0, y: 30 });

				ScrollTrigger.create({
					trigger: "#palette",
					start: "top 75%",
					onEnter: () => {
						const tlPalette = gsap.timeline();

						tlPalette.to(linesPaletteTitle, {
							y: "0%",
							duration: 0.6,
							ease: "power3.out"
						})

							.to(linesPaletteNum, {
								y: "0%",
								duration: 0.6,
								ease: "power3.out"
							}, "-=0.4")

							.to(palettes, {
								opacity: 1,
								y: 0,
								duration: 0.8,
								stagger: 0.2,
								ease: "power3.out"
							}, "-=0.2");
					},
					once: true
				});
			}

			const overlay = document.getElementById('transition-overlay');
			const isFirstLoad = document.documentElement.classList.contains('is-first-load');
			const isTransitioning = overlay && overlay.style.pointerEvents === 'auto';

			if (isFirstLoad || isTransitioning) {
				window.addEventListener('transition-finished', playHeroAnimation, { once: true });
			} else {
				playHeroAnimation();
			}
		}

		let mm = gsap.matchMedia();

		const cleanupIndex = () => {
			lenis.destroy();
			gsap.ticker.remove(tickerFn);
			mm.revert();
			ScrollTrigger.getAll().forEach((t) => t.kill());
			document.removeEventListener("astro:before-swap", cleanupIndex);
		};
		document.addEventListener("astro:before-swap", cleanupIndex);

		const allWorkProjects = document.querySelectorAll("#work .project-wrapper");
		allWorkProjects.forEach((project) => {
			project.addEventListener("click", (e) => {
				if (!e.target.closest("a")) {
					const link = project.querySelector("a.project-image");
					if (link && link.href) {
						link.click();
					}
				}
			});
		});

		mm.add("(min-width: 1024px)", () => {
			const projects = document.querySelectorAll(".project-wrapper");

			projects.forEach((project) => {
				const projectImage = project.querySelector(".project-image");
				const videoContainer = project.querySelector(".video-container");
				const video = project.querySelector("video");
				const blurBg = project.querySelector(".blurred-background");
				const rolesText = project.querySelector(".project-roles");

				if (!rolesText || !videoContainer || !projectImage) return;

				if (video) video.muted = true;

				const split = new SplitType(rolesText, { types: 'lines' });

				split.lines.forEach((el) => {
					const wrapper = document.createElement('div');
					wrapper.style.overflow = 'hidden';
					wrapper.style.display = 'block';
					el.parentNode.insertBefore(wrapper, el);
					wrapper.appendChild(el);
				});

				gsap.set(split.lines, { y: "100%" });
				gsap.set(videoContainer, { scale: 0.8, xPercent: -50, yPercent: -50 });

				const xTo = gsap.quickTo(videoContainer, "x", { duration: 0.4, ease: "power3.out" });
				const yTo = gsap.quickTo(videoContainer, "y", { duration: 0.4, ease: "power3.out" });

				const textTl = gsap.timeline({ paused: true })
					.to(split.lines, { y: "0%", duration: 0.4, stagger: 0.05, ease: "power3.out" });

				const videoTl = gsap.timeline({ paused: true })
					.to(blurBg, { opacity: 1, duration: 0.4, ease: "power2.inOut" }, 0)
					.to(videoContainer, { opacity: 1, scale: 1, duration: 0.5, ease: "power3.out" }, 0);

				project.addEventListener("mouseenter", () => {
					textTl.play();
				});

				project.addEventListener("mouseleave", () => {
					textTl.reverse();
				});

				let pauseCall = null;

				projectImage.addEventListener("mouseenter", () => {
					if (pauseCall) pauseCall.kill();
					videoTl.play();
					if (video) {
						video.play().catch(() => {});
					}
				});

				projectImage.addEventListener("mouseleave", () => {
					videoTl.reverse();
					if (video) {
						pauseCall = gsap.delayedCall(videoTl.duration(), () => video.pause());
					}
					xTo(0);
					yTo(0);
				});

				projectImage.addEventListener("mousemove", (e) => {
					const rect = projectImage.getBoundingClientRect();
					const centerX = rect.left + rect.width / 2;
					const centerY = rect.top + rect.height / 2;

					const moveX = (e.clientX - centerX) * 0.2;
					const moveY = (e.clientY - centerY) * 0.2;

					xTo(moveX);
					yTo(moveY);
				});
			});

			const hoverPalettes = document.querySelectorAll('.palette');

			hoverPalettes.forEach((palette) => {
				const detailsWrapper = palette.querySelector('.palette-details-wrapper');
				const detailLines = palette.querySelectorAll('.palette-details p');

				gsap.set(detailsWrapper, { opacity: 0 });
				gsap.set(detailLines, { y: "100%", opacity: 0 });

				const tlHover = gsap.timeline({ paused: true });

				tlHover.to(detailsWrapper, {
					opacity: 1,
					duration: 0.3,
					ease: "power2.out"
				})
					.to(detailLines, {
						y: "0%",
						opacity: 1,
						duration: 0.4,
						stagger: 0.05,
						ease: "power3.out"
					}, "-=0.15");

				let tlImages, tlUI, tlDev;
				if (palette.classList.contains('palette1')) {
					const bgImages = palette.querySelectorAll('.palette-bg-images img');
					tlImages = gsap.timeline({ paused: true });
					tlImages.to(bgImages, {
						opacity: 1,
						x: 0,
						y: 0,
						duration: 0.6,
						stagger: 0.1,
						ease: "back.out(1.2)"
					});
				}
				else if (palette.classList.contains('palette2')) {
					const uiLayers = palette.querySelectorAll('.ui-layer');


					gsap.set(uiLayers, { opacity: 0, rotationX: 60, rotationZ: -45, y: 50 });

					tlUI = gsap.timeline({ paused: true });
					tlUI.to(uiLayers, {
						opacity: 1,
						x: (index) => index * -35,
						y: (index) => index * -45,
						duration: 0.6,
						stagger: 0.15,
						ease: "power3.out"
					});
				}
				else if (palette.classList.contains('palette3')) {
					const codeSpans = palette.querySelectorAll('.code-line span');

					gsap.set(codeSpans, { width: "0%" });

					tlDev = gsap.timeline({ paused: true });
					tlDev.to(codeSpans, {
						width: "100%",
						duration: 0.8,
						stagger: 0.15,
						ease: "steps(20)"
					});
				}


				palette.addEventListener('mouseenter', () => {
					tlHover.play();
					if (tlImages) tlImages.timeScale(1).play();
					if (tlUI) tlUI.timeScale(1).play();
					if (tlDev) tlDev.timeScale(1).play();
				});

				palette.addEventListener('mouseleave', () => {
					tlHover.reverse();
					if (tlImages) tlImages.timeScale(4).reverse();
					if (tlUI) tlUI.timeScale(3).reverse();
					if (tlDev) tlDev.timeScale(5).reverse();
				});
			});
		});
	});
</script>