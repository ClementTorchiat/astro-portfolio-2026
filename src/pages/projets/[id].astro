---
import { getCollection, render } from "astro:content";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
    const projetsBruts = await getCollection("projets");
    const projets = projetsBruts.sort((a, b) => a.data.order - b.data.order);

    return projets.map((projet, index) => {
        const nextProject = projets[(index + 1) % projets.length];

        return {
            params: { id: projet.id },
            props: { projet, nextProject },
        };
    });
}

const { projet, nextProject } = Astro.props;
const { Content } = await render(projet);
---

<Layout
    titre={`${projet.data.title} - Clément Torchiat`}
    masquerFooter={false}
    typeHeader="alternatif"
>
    <main class="project-page">
        <header class="project-header">
            <div class="col-info">
                <h1>{projet.data.title}</h1>
                <p>{projet.data.description}</p>
                {
                    projet.data.link && (
                        <a
                            href={projet.data.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="project-link"
                            data-cursor-text="Visiter"
                        >
                            <span>
                                {projet.data.linkLabel || "Visiter le site"}
                            </span>
                        </a>
                    )
                }
            </div>
            <div class="col-roles">
                <h3>RÔLES :</h3>
                <ul>
                    {projet.data.tags.map((tag) => <li>{tag}</li>)}
                </ul>
            </div>
            <div class="col-client">
                <h3>CLIENT :</h3>
                <p>{projet.data.clientName}</p>
                <p>{projet.data.clientCompany}</p>
                <p>{projet.data.year}</p>
            </div>
        </header>

        <section class="project-body">
            <article class="project-content">
                <Content />
            </article>

            <aside class="minimap-container">
                <div class="minimap">
                    <div class="minimap-viewport"></div>
                    <div class="minimap-content"></div>
                </div>
            </aside>
        </section>

        <section class="next-project">
            <p>(Prochain projet)</p>
            <h2>{nextProject.data.title}</h2>
            <a href={`/projets/${nextProject.id}`} data-cursor-text="Voir">
                <img
                    src={nextProject.data.coverImage.src}
                    alt={`Projet ${nextProject.data.title}`}
                />
            </a>
        </section>
    </main>
</Layout>

<style>
    .project-page {
        background-color: var(--white);
        color: var(--black);
        padding: 150px 20px 0 20px;
        min-height: 100vh;
    }

    .project-content :global(img) {
        width: 100%;
        height: auto;
        display: block;
    }

    .project-header {
        display: grid;
        grid-template-columns: 2fr 1fr 1fr;
        gap: 2rem;
        margin-bottom: 80px;
        align-items: start;
    }

    .col-info h1 {
        font-family: "Jubilee", serif;
        font-size: 3rem;
        text-transform: uppercase;
        margin-bottom: 1rem;
        color: var(--black);
    }

    .col-info p {
        font-size: 1.1rem;
        line-height: 1.4;
        max-width: 90%;
    }

    .project-link {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 1rem;
        font-family: "Switzer", sans-serif;
        font-size: 0.8rem;
        font-weight: 500;
        color: #2563eb;
        text-decoration: underline;
        text-decoration-color: rgba(37, 99, 235, 0.4);
        text-underline-offset: 4px;
        text-decoration-thickness: 1.5px;
        transition:
            color 0.25s ease,
            text-decoration-color 0.25s ease;
    }

    .project-link:hover {
        color: #1d4ed8;
        text-decoration-color: #1d4ed8;
    }

    .col-roles h3,
    .col-client h3 {
        font-family: "Switzer", sans-serif;
        font-weight: 700;
        font-size: 0.9rem;
        text-transform: uppercase;
        margin-bottom: 0.5rem;
    }

    .col-roles ul {
        list-style: none;
        padding: 0;
    }

    .col-roles li,
    .col-client p {
        font-size: 0.9rem;
        font-weight: 500;
        line-height: 1.6;
        font-family: "Switzer", sans-serif;
    }

    .project-body {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
    }

    .project-content {
        width: 75%;
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .project-content :global(h2) {
        font-family: "Jubilee", serif;
        font-size: 2.2rem;
        line-height: 1.15;
        margin-top: 3.5rem;
        margin-bottom: 0.25rem;
        text-transform: uppercase;
        color: var(--black);
    }

    .project-content :global(p) {
        font-family: "Switzer", sans-serif;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--black);
    }

    .project-content :global(ul) {
        list-style: disc;
        padding-left: 1.5rem;
        display: flex;
        flex-direction: column;
        gap: 0.85rem;
    }

    .project-content :global(li) {
        font-family: "Switzer", sans-serif;
        font-size: 1.05rem;
        line-height: 1.6;
        color: var(--black);
    }

    .project-content :global(li strong) {
        font-weight: 600;
        color: var(--black);
    }

    .project-content :global(img) {
        width: 100%;
        height: auto;
        display: block;
    }

    .minimap-container {
        position: fixed;
        top: 220px;
        right: 10%;
        width: 80px;
        display: flex;
        justify-content: flex-end;
        z-index: 10;
    }

    .minimap {
        position: relative;
    }

    .minimap-content {
        /* Wrapper for scaled clone */
    }

    /* Transform text elements into skeleton blocks for the minimap */
    .minimap-content :global(p),
    .minimap-content :global(h1),
    .minimap-content :global(h2),
    .minimap-content :global(h3),
    .minimap-content :global(li) {
        color: transparent !important;
        background-color: #e6e6e6 !important;
        border-radius: 4px;
        line-height: 1;
    }

    .minimap-content :global(.project-link) {
        display: none !important;
    }

    .minimap-content :global(img) {
        width: 100%;
        height: auto;
        display: block;
        opacity: 1 !important;
    }

    .minimap-viewport {
        position: absolute;
        top: 0;
        left: -4px;
        width: calc(100% + 8px);
        height: 50px;
        border: 2px solid #1a1a1a;
        pointer-events: none;
        z-index: 2;
        transition: transform 0.1s ease-out;
    }

    .next-project {
        margin-top: 150px;
        padding-bottom: 50px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        position: relative;
        z-index: 20;
        background-color: var(--white);
    }

    .next-project p {
        color: var(--light-grey);
        font-family: Jubilee, serif;
        font-size: 15px;
        line-height: 1.5;
        font-weight: 500;
        margin-bottom: 8px;
    }

    .next-project h2 {
        font-family: "Jubilee", serif;
        font-size: 4rem;
        text-transform: uppercase;
        margin-bottom: 2rem;
        color: var(--black);
    }

    .next-project a {
        width: 100%;
        display: block;
        overflow: hidden;
    }

    .next-project img {
        width: 100%;
        height: auto;
        max-height: 80vh;
        object-fit: cover;
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .next-project a:hover img {
        transform: scale(1.02);
    }

    :global(.site-footer) {
        position: relative;
        z-index: 20;
        background-color: var(--white);
    }

    :global(.lightbox) {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        background-color: rgba(0, 0, 0, 0.9);
        z-index: 9998;
        display: flex;
        justify-content: center;
        align-items: center;
        opacity: 0;
        transition: opacity 0.3s ease;
    }

    :global(.lightbox img) {
        max-width: 90vw;
        max-height: 90vh;
        object-fit: contain;
        transform: scale(0.95);
        transition: transform 0.3s ease;
        box-shadow: 0 10px 40px rgba(0, 0, 0, 0.5);
    }

    :global(.lightbox.active) {
        opacity: 1;
    }

    :global(.lightbox.active img) {
        transform: scale(1);
    }

    @media (min-width: 1024px) {
        .project-page {
            padding: 150px 128px 0 128px;
        }
    }

    @media (max-width: 1000px) {
        .project-header {
            grid-template-columns: 1fr;
            gap: 2rem;
        }
        .project-content {
            width: 100%;
        }
        .minimap-container {
            display: none;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import SplitType from "split-type";
    import Lenis from "lenis";

    gsap.registerPlugin(ScrollTrigger, SplitType);

    let abortController;

    document.addEventListener("astro:page-load", () => {
        if (abortController) abortController.abort();
        abortController = new AbortController();
        const { signal } = abortController;

        const lenis = new Lenis();
        lenis.on("scroll", ScrollTrigger.update);

        const tickerFn = (time) => {
            lenis.raf(time * 1000);
        };
        gsap.ticker.add(tickerFn);
        gsap.ticker.lagSmoothing(0);

        const cleanupId = () => {
            lenis.destroy();
            gsap.ticker.remove(tickerFn);
            ScrollTrigger.getAll().forEach((t) => t.kill());
            document.removeEventListener("astro:before-swap", cleanupId);
        };
        document.addEventListener("astro:before-swap", cleanupId);

        const prepareSplitReveal = (elements) => {
            let allLines = [];
            const els =
                Array.isArray(elements) || elements instanceof NodeList
                    ? elements
                    : [elements];

            els.forEach((element) => {
                if (
                    !element ||
                    window.getComputedStyle(element).display === "none"
                )
                    return;
                const split = new SplitType(element, { types: "lines" });
                split.lines.forEach((el) => {
                    const wrapper = document.createElement("div");
                    wrapper.style.overflow = "hidden";
                    wrapper.style.display = "block";
                    el.parentNode.insertBefore(wrapper, el);
                    wrapper.appendChild(el);
                });
                gsap.set(split.lines, { y: "100%" });
                allLines.push(...split.lines);
            });
            return allLines;
        };

        const headerTexts = document.querySelectorAll(
            ".col-info h1, .col-info p, .col-roles h3, .col-roles li, .col-client h3, .col-client p",
        );
        const linesHeader = prepareSplitReveal(headerTexts);
        const minimapContainer = document.querySelector(".minimap-container");
        const projectLink = document.querySelector(".project-link");

        if (minimapContainer) gsap.set(minimapContainer, { opacity: 0 });
        if (projectLink) gsap.set(projectLink, { opacity: 0, y: 15 });

        // Split and hide body text lines immediately (synchronously) so they are hidden
        // before the page transition finishes, avoiding any flash of unhidden text.
        const contentTextElements = Array.from(
            document.querySelectorAll(
                ".project-content h1, .project-content h2, .project-content h3, .project-content h4, .project-content h5, .project-content h6, .project-content p, .project-content li, .project-content blockquote",
            ),
        ).filter(
            (el) =>
                !el.querySelector("img") && el.textContent.trim().length > 0,
        );

        const contentTextEntries = contentTextElements
            .map((el) => ({
                el,
                lines: prepareSplitReveal(el),
            }))
            .filter((entry) => entry.lines.length > 0);

        const playProjectIntro = () => {
            const tlIntro = gsap.timeline();

            if (linesHeader.length > 0) {
                tlIntro.to(linesHeader, {
                    y: "0%",
                    duration: 0.8,
                    stagger: 0.02,
                    ease: "power3.out",
                });
            }
            if (minimapContainer) {
                tlIntro.to(
                    minimapContainer,
                    {
                        opacity: 1,
                        duration: 1,
                        ease: "power2.out",
                    },
                    "-=0.4",
                );
            }
            if (projectLink) {
                tlIntro.to(
                    projectLink,
                    {
                        opacity: 1,
                        y: 0,
                        duration: 0.8,
                        ease: "power3.out",
                    },
                    "-=0.4",
                );
            }

            // Activate ScrollTriggers for body text now that the transition is finished
            contentTextEntries.forEach(({ el, lines }) => {
                ScrollTrigger.create({
                    trigger: el,
                    start: "top 85%",
                    onEnter: () => {
                        gsap.to(lines, {
                            y: "0%",
                            duration: 0.8,
                            stagger: 0.02,
                            ease: "power3.out",
                        });
                    },
                    once: true,
                });
            });
        };

        const overlay = document.getElementById("transition-overlay");
        const isFirstLoad =
            document.documentElement.classList.contains("is-first-load");
        const isTransitioning =
            overlay && overlay.style.pointerEvents === "auto";

        if (isFirstLoad || isTransitioning) {
            window.addEventListener("transition-finished", playProjectIntro, {
                once: true,
                signal,
            });
        } else {
            playProjectIntro();
        }

        const contentImages = document.querySelectorAll(".project-content img");
        const minimapContent = document.querySelector(".minimap-content");
        const minimapViewport = document.querySelector(".minimap-viewport");
        const projectHeader = document.querySelector(".project-header");
        const projectContent = document.querySelector(".project-content");
        const minimap = document.querySelector(".minimap");
        const projectPage = document.querySelector(".project-page");

        if (
            minimapContent &&
            minimapViewport &&
            projectContent &&
            projectHeader &&
            minimap &&
            projectPage
        ) {
            minimapContent.innerHTML = "";

            // Container to hold spacer + header + content
            const cloneContainer = document.createElement("div");

            // Simulate the 150px top padding of the page
            const spacer = document.createElement("div");
            spacer.style.height = "150px";
            cloneContainer.appendChild(spacer);

            const headerClone = projectHeader.cloneNode(true);
            const contentClone = projectContent.cloneNode(true);

            // "Cheat" by forcing the cloned content to take full width
            // so it aligns with the full-width header, eliminating the right-side gap.
            contentClone.style.width = "100%";

            cloneContainer.appendChild(headerClone);
            cloneContainer.appendChild(contentClone);

            // Clean up the clone to remove IDs and GSAP styles
            const allElements = cloneContainer.querySelectorAll("*");
            allElements.forEach((el) => {
                el.removeAttribute("id");
                el.removeAttribute("data-cursor-text");
                el.style.opacity = "1";
                el.style.transform = "none";
            });
            cloneContainer.style.opacity = "1";
            cloneContainer.style.transform = "none";

            minimapContent.appendChild(cloneContainer);

            const updateMinimap = () => {
                if (projectContent.getBoundingClientRect().width === 0) return;

                const pageRect = projectPage.getBoundingClientRect();
                const contentRect = projectContent.getBoundingClientRect();
                const headerRect = projectHeader.getBoundingClientRect();
                const windowHeight = window.innerHeight;

                const totalWidth = headerRect.width;

                // Set width before measuring so layout can flow and images can stretch
                minimapContent.style.width = `${totalWidth}px`;
                const cloneHeight = cloneContainer.offsetHeight;

                // Restrict minimap height to prevent overflow
                const maxMinimapHeight = windowHeight - 320;
                const maxMinimapWidth = 80;

                const scaleX = maxMinimapWidth / totalWidth;
                const scaleY = maxMinimapHeight / cloneHeight;
                const scale = Math.min(scaleX, Math.min(scaleY, 1));

                // Scale the clone
                minimapContent.style.position = "absolute";
                minimapContent.style.top = "0";
                minimapContent.style.left = "0";
                minimapContent.style.transformOrigin = "top left";
                minimapContent.style.transform = `scale(${scale})`;

                // Size the minimap wrapper
                minimap.style.width = `${totalWidth * scale}px`;
                minimap.style.height = `${cloneHeight * scale}px`;

                // Update the viewport indicator size
                const viewportHeight = windowHeight * scale;
                minimapViewport.style.height = `${viewportHeight}px`;
                minimapViewport.style.width = `calc(100% + 4px)`;
                minimapViewport.style.left = `-2px`;
                minimapViewport.style.top = `0px`;

                // Calculate progress against the real page bounds
                const realTotalHeight = contentRect.bottom - pageRect.top;
                const maxRealScroll = realTotalHeight - windowHeight;

                let progress = 0;
                if (maxRealScroll > 0) {
                    progress = -pageRect.top / maxRealScroll;
                    progress = Math.max(0, Math.min(progress, 1));
                }

                // Map progress to the stretched clone's height
                const maxTranslate = Math.max(
                    0,
                    cloneHeight * scale - viewportHeight,
                );
                const translateValue = progress * maxTranslate;

                minimapViewport.style.transform = `translateY(${translateValue}px)`;
            };

            window.addEventListener("scroll", updateMinimap, {
                passive: true,
                signal,
            });
            window.addEventListener("resize", updateMinimap, { signal });

            setTimeout(updateMinimap, 100);
            setTimeout(updateMinimap, 1000); // Safety update after images fully load
        }

        contentImages.forEach((img) => {
            gsap.set(img, { opacity: 0, y: 60 });

            ScrollTrigger.create({
                trigger: img,
                start: "top 85%",
                onEnter: () => {
                    gsap.to(img, {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        ease: "power3.out",
                    });
                },
                once: true,
            });

            img.setAttribute("data-cursor-text", "Agrandir");
            img.addEventListener("click", () => {
                const lightbox = document.createElement("div");
                lightbox.className = "lightbox";
                lightbox.setAttribute("data-cursor-text", "Fermer");

                const imgClone = document.createElement("img");
                imgClone.src = (img as HTMLImageElement).src;

                lightbox.appendChild(imgClone);
                document.body.appendChild(lightbox);
                document.dispatchEvent(new CustomEvent("dom-updated"));

                requestAnimationFrame(() => {
                    lightbox.classList.add("active");
                });

                lightbox.addEventListener("click", () => {
                    lightbox.classList.remove("active");
                    lightbox.dispatchEvent(new Event("mouseleave"));
                    setTimeout(() => {
                        lightbox.remove();
                    }, 300);
                });
            });
        });

        const nextTexts = document.querySelectorAll(
            ".next-project p, .next-project h2",
        );
        const nextImage = document.querySelector(".next-project img");

        if (nextTexts.length > 0 && nextImage) {
            const linesNext = prepareSplitReveal(nextTexts);

            gsap.set(nextImage, { opacity: 0, scale: 0.95 });

            ScrollTrigger.create({
                trigger: ".next-project",
                start: "top 80%",
                onEnter: () => {
                    const tlNext = gsap.timeline();

                    tlNext
                        .to(linesNext, {
                            y: "0%",
                            duration: 0.8,
                            stagger: 0.1,
                            ease: "power3.out",
                        })
                        .to(
                            nextImage,
                            {
                                opacity: 1,
                                scale: 1,
                                duration: 1.2,
                                ease: "power3.out",
                            },
                            "-=0.6",
                        );
                },
                once: true,
            });
        }

        document.dispatchEvent(new CustomEvent("dom-updated"));
    });
</script>
