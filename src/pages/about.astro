---
import Layout from "../layouts/Layout.astro";
import { Image } from 'astro:assets';

import palette1 from "../assets/images/palette-1-1.webp";
---

<Layout 
    titre="À propos — Clément Torchiat | DA, UX/UI & Développeur Web" 
    description="Directeur artistique, UX/UI designer et développeur web. Découvrez le parcours de Clément Torchiat, sa vision produit, ses compétences et son univers créatif."
    schemaType="AboutPage"
    breadcrumb={[{ name: "À propos", path: "/about" }]}
    image="/og-image.png"
    imageAlt="À propos de Clément Torchiat — Directeur Artistique & Développeur Web"
    masquerFooter={false} 
    typeHeader="alternatif">
    <div class="about-container">
        <div class="about-top">
            <div class="top-content-container">
                <div class="about-services">
                    <div class="about">
                        <p class="grey-subtitle">(À propos)</p>
                        <p>
                            Je suis <strong>Clément Torchiat</strong>, directeur artistique, UX/UI designer et développeur web. Passé par Peugeot Motocycles pour affûter ma vision produit, je façonne aujourd'hui des écosystèmes digitaux de A à Z.
                            <br><br>
                            Fasciné par le design global, nourri par la culture gaming et l'esthétique pop, j'aime donner vie à des projets atypiques et immersifs. Mon objectif est de créer des interfaces qui marquent les esprits et sortent de l'ordinaire.
                        </p>
                    </div>
                    <div class="services">
                        <p class="grey-subtitle">(Services)</p>
                        <ul>
                            <li>Site Complet</li>
                            <li>Direction Créative</li>
                            <li>Product Design</li>
                            <li>Développement Web</li>
                            <li>Charte Graphique</li>
                        </ul>
                    </div>
                </div>
                <div class="experience-container">
                    <p class="grey-subtitle">(Expérience)</p>
                    <div class="experience-subcontainer">
                        <div class="experience-line">
                            <p class="experience-years">2025-2026</p>
                            <div class="experience-content">
                                <p class="experience-content-title">Directeur artistique en freelance</p>
                                <p class="experience-content-subtitle">UX/UI, branding et product design.</p>
                            </div>
                        </div>
                        <div class="experience-line">
                            <p class="experience-years">2022-2023</p>
                            <div class="experience-content">
                                <p class="experience-content-title">Alternant chef de projet web & UX/UI Designer</p>
                                <p class="experience-content-subtitle">Peugeot Motocycles, Mandeure.</p>
                            </div>
                        </div>
                        <div class="experience-line">
                            <p class="experience-years">2022</p>
                            <div class="experience-content">
                                <p class="experience-content-title">Stage en UX/UI design & communication interne</p>
                                <p class="experience-content-subtitle">Peugeot Motocycles, Mandeure.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="top-spacer">
                <div class="about-visual">
                    <div class="cube-scene">
                        <div class="cube">
                            <div class="cube-core"></div>
                            <div class="cube-face front"></div>
                            <div class="cube-face back"></div>
                            <div class="cube-face right"></div>
                            <div class="cube-face left"></div>
                            <div class="cube-face top"></div>
                            <div class="cube-face bottom"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <div class="about-bottom">
            <p class="grey-subtitle">(Formation)</p>
            <div class="experience-subcontainer">
                <div class="experience-line">
                    <p class="experience-years">2027</p>
                    <div class="experience-content">
                        <p class="experience-content-title">Master Technologies de l’Information - Produits et Services Multimédias</p>
                        <p class="experience-content-subtitle">Université Marie et Louis Pasteur, (UFR STGI) Montbéliard, France.</p>
                    </div>
                </div>
                <div class="experience-line">
                    <p class="experience-years">2023</p>
                    <div class="experience-content">
                        <p class="experience-content-title">Licence Professionnelle Métiers du Numérique : Conception, Rédaction et Réalisation Web - Webdesign</p>
                        <p class="experience-content-subtitle">Université Marie et Louis Pasteur, (UFR STGI) Montbéliard, France.</p>
                    </div>
                </div>
                <div class="experience-line">
                    <p class="experience-years">2022</p>
                    <div class="experience-content">
                        <p class="experience-content-title">DUT Métiers du Multimédia et de l’Internet</p>
                        <p class="experience-content-subtitle">Université Marie et Louis Pasteur, (UFR STGI) Montbéliard, France.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style>
    .grey-subtitle {
        font-family: 'Jubilee', serif;
        font-size: 15px;
        line-height: 1.5;
        font-weight: 500;
        color: var(--light-grey);
        margin-bottom: 8px;
    }

    .about-container {
        display: flex;
        flex-direction: column;
        margin: 8rem 20px 64px;
        gap: 48px;
    }

    .about-top {
        display: flex;
        flex-direction: column-reverse;
    }

    .top-spacer {
        display: none;
    }

    .about-visual {
        width: 100%;
        aspect-ratio: 4 / 5;
        position: relative;
        display: flex;
        justify-content: center;
        align-items: center;
        perspective: 1000px;
        transform: translateX(-15%);
    }

    .cube-scene {
        width: 100%;
        height: 100%;
        perspective: 1000px;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .cube {
        width: 140px;
        height: 140px;
        position: relative;
        transform-style: preserve-3d;
        transform: rotateX(-20deg) rotateY(-45deg);
    }

    .cube-face {
        position: absolute;
        width: 140px;
        height: 140px;
        background: rgba(0, 0, 0, 0.02);
        border: 1px solid rgba(0, 0, 0, 0.06);
        display: flex;
        justify-content: center;
        align-items: center;
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
    }

    .cube-face.front  { transform: rotateY(  0deg) translateZ(70px); }
    .cube-face.right  { transform: rotateY( 90deg) translateZ(70px); }
    .cube-face.back   { transform: rotateY(180deg) translateZ(70px); }
    .cube-face.left   { transform: rotateY(-90deg) translateZ(70px); }
    .cube-face.top    { transform: rotateX( 90deg) translateZ(70px); }
    .cube-face.bottom { transform: rotateX(-90deg) translateZ(70px); }

    .cube-core {
        position: absolute;
        top: 50%;
        left: 50%;
        width: 32px;
        height: 32px;
        background: var(--black);
        border-radius: 50%;
        transform: translate(-50%, -50%) translateZ(0);
        box-shadow: 0 0 30px rgba(0, 0, 0, 0.15);
    }

    .top-content-container {
        display: flex;
        flex-direction: column;
        gap: 48px;
    }

    .about-services {
        display: flex;
        flex-direction: column;
        gap: 48px;
    }

    .services ul li {
        font-family: 'Switzer', sans-serif;
        font-size: 16px;
        font-weight: 400;
    }

    .experience-subcontainer {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .experience-line {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .experience-years {
        text-decoration: underline;
        font-family: 'Jubilee', serif;
        font-weight: 500;
        font-size: 24px;
    }

    .experience-content {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .experience-content-title {
        font-family: 'Jubilee', serif;
        font-weight: 500;
        font-size: 20px;
    }

    @media (min-width: 1024px) {
        .about-container {
            margin: 160px 30px 140px;
        }

        .about-top {
            flex-direction: row;
            gap: 8vw;
        }

        .top-content-container {
            flex: 3;
            display: flex;
            flex-direction: column;
            gap: 48px;
        }

        .top-spacer {
            flex: 1;
            display: block;
        }

        .about-services {
            flex-direction: row;
            gap: 8vw;
        }

        .about {
            flex: 1;
        }

        .services {
            width: max-content;
            flex-shrink: 0;
        }

        .experience-line {
            flex-direction: row;
            gap: 8px;
        }

        .experience-years {
            min-width: 160px;
            flex-shrink: 0;
        }
    }
</style>

<script>
    // @ts-nocheck
    import { gsap } from "gsap";
    import { ScrollTrigger } from "gsap/ScrollTrigger";
    import SplitType from "split-type";
    import Lenis from 'lenis';

    gsap.registerPlugin(ScrollTrigger, SplitType);

    let abortController;

    document.addEventListener("astro:page-load", () => {
        if (abortController) abortController.abort();
        abortController = new AbortController();
        const { signal } = abortController;

        const lenis = new Lenis();

        lenis.on('scroll', ScrollTrigger.update);

        const tickerFn = (time) => {
            lenis.raf(time * 1000);
        };
        gsap.ticker.add(tickerFn);
        gsap.ticker.lagSmoothing(0);

        const cleanupAbout = () => {
            lenis.destroy();
            gsap.ticker.remove(tickerFn);
            ScrollTrigger.getAll().forEach(t => t.kill());
            document.removeEventListener('astro:before-swap', cleanupAbout);
        };
        document.addEventListener('astro:before-swap', cleanupAbout);

        const aboutContainer = document.querySelector('.about-container');
        if (!aboutContainer) return;

        const prepareSplitReveal = (elements) => {
            let allLines = [];
            const els = Array.isArray(elements) || elements instanceof NodeList ? elements : [elements];

            els.forEach(element => {
                if (!element || window.getComputedStyle(element).display === 'none') return;
                const split = new SplitType(element, { types: 'lines' });
                split.lines.forEach((el) => {
                    const wrapper = document.createElement('div');
                    wrapper.style.overflow = 'hidden';
                    wrapper.style.display = 'block';
                    el.parentNode.insertBefore(wrapper, el);
                    wrapper.appendChild(el);
                });
                gsap.set(split.lines, { y: "100%" });
                allLines.push(...split.lines);
            });
            return allLines;
        };

        const aboutTexts = document.querySelectorAll('.about p, .services p, .services li');
        const expTopTexts = document.querySelectorAll('.top-content-container .experience-years, .top-content-container .experience-content p, .top-content-container .grey-subtitle');
        const aboutVisualContainer = document.querySelector('.about-visual');

        const linesAbout = prepareSplitReveal(aboutTexts);
        const linesExpTop = prepareSplitReveal(expTopTexts);

        if (aboutVisualContainer) {
            gsap.set(aboutVisualContainer, { opacity: 0, scale: 0.95 });
        }

        const bottomTexts = document.querySelectorAll('.about-bottom .grey-subtitle, .about-bottom .experience-years, .about-bottom .experience-content p');
        const linesBottom = prepareSplitReveal(bottomTexts);

        const playAboutIntro = () => {
            const tlIntro = gsap.timeline();

            tlIntro.to(linesAbout, {
                y: "0%",
                duration: 0.8,
                stagger: 0.05,
                ease: "power3.out"
            })
                .to(linesExpTop, {
                    y: "0%",
                    duration: 0.8,
                    stagger: 0.05,
                    ease: "power3.out"
                }, "-=0.6");

            if (aboutVisualContainer) {
                tlIntro.to(aboutVisualContainer, {
                    opacity: 1,
                    scale: 1,
                    duration: 1.2,
                    ease: "power3.out"
                }, "-=1.2");
            }
        };

        const overlay = document.getElementById('transition-overlay');
        const isFirstLoad = document.documentElement.classList.contains('is-first-load');
        const isTransitioning = overlay && overlay.style.pointerEvents === 'auto';

        if (isFirstLoad || isTransitioning) {
            window.addEventListener('transition-finished', playAboutIntro, { once: true, signal });
        } else {
            playAboutIntro();
        }

        if (linesBottom.length > 0) {
            ScrollTrigger.create({
                trigger: ".about-bottom",
                start: "top 85%",
                onEnter: () => {
                    gsap.to(linesBottom, {
                        y: "0%",
                        duration: 0.8,
                        stagger: 0.05,
                        ease: "power3.out"
                    });
                },
                once: true
            });
        }

        const cube = document.querySelector('.cube');
        const core = document.querySelector('.cube-core');
        
        if (cube) {
            gsap.to(cube, {
                rotationX: "+=360",
                rotationY: "+=360",
                duration: 20,
                repeat: -1,
                ease: "none"
            });
            
            if (core) {
                gsap.to(core, {
                    scale: 1.6,
                    opacity: 0.8,
                    duration: 2,
                    yoyo: true,
                    repeat: -1,
                    ease: "sine.inOut"
                });
            }
        }
    });
</script>