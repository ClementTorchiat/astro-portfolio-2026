---
import Layout from "../layouts/Layout.astro";
import { getCollection } from 'astro:content';

const projetsBruts = await getCollection('projets');
const projets = projetsBruts.sort((a, b) => a.data.order - b.data.order);
const slidesData = projets.map((projet) => ({
    slideTitle: projet.data.title,
    slideDescription: projet.data.description,
    slideUrl: `/projets/${projet.id}`,
    slideTags: projet.data.tags,
    slideImg: projet.data.coverImage.src,
}));
---

<Layout 
    titre="Projets & Réalisations — Clément Torchiat" 
    description="Explorez mes projets récents en direction artistique, ergonomie UX/UI et développement web créatif : études de cas et réalisations interactives."
    schemaType="CollectionPage"
    breadcrumb={[{ name: "Projets", path: "/work" }]}
    image="/og-image.png"
    imageAlt="Projets et réalisations de Clément Torchiat"
    masquerFooter={true} 
    typeHeader="normal">
    <div class="work-page">
        <div class="slider" data-slides={JSON.stringify(slidesData)}>
            <div class="slide">
                <a href={slidesData[0].slideUrl} class="slide-img" data-cursor-text="Voir le projet">
                    <img src={slidesData[0].slideImg} alt={`Image de couverture du projet ${slidesData[0].slideTitle}`}>
                </a>
                <div class="slide-header">
                    <div class="slide-title">
                        <h1>{slidesData[0].slideTitle}</h1>
                    </div>
                    <div class="slide-description">
                        <p>{slidesData[0].slideDescription}</p>
                    </div>
                    <div class="slide-link">
                        <a data-cursor-hover href={slidesData[0].slideUrl}>Voir le projet</a>
                    </div>
                </div>
                <div class="slide-info">
                    <div class="slide-tags">
                        <p>Tags</p>
                        {slidesData[0].slideTags.map((tag) => (
                                <p>{tag}</p>
                        ))}
                    </div>
                    <div class="slide-index-wrapper">
                        <p id="slide-index">01</p>
                        <p>/</p>
                        <p id="total-slide-count">{String(slidesData.length).padStart(2, "0")}</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</Layout>

<style is:global>
    .work-page * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }

    .work-page {
        font-family: 'Switzer', sans-serif;
    }

    .work-page img {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .work-page h1, .work-page p, .work-page a {
        color: var(--white);
    }

    .work-page h1 {
        text-transform: uppercase;
        font-size: 5rem;
        font-weight: 500;
        letter-spacing: -0.1rem;
        font-family: 'Jubilee', serif;
    }

    .work-page p, .work-page a {
        text-decoration: none;
        font-family: 'Switzer', sans-serif;
        font-size: 0.9rem;
        font-weight: 500;
        letter-spacing: -0.01rem;
    }

    .work-page .slide-link a {
        text-decoration: underline;
    }

    .work-page .slider {
        position: relative;
        width: 100vw;
        height: 100svh;
        background-color: var(--black);
        overflow: hidden;
    }

    .work-page .slide, .work-page .slide-img {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100svh;
    }

    .work-page .slide-index-wrapper {
        display: flex;
        flex-direction: row;
        gap: 4px;
    }

    .work-page .slide-header {
        position: absolute;
        bottom: 2rem;
        left: 50%;
        transform: translate(-50%, 0);
        width: 75%;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1rem;
        z-index: 1;
    }

    .work-page .slide-description {
        width: 60%;
        text-align: center;
        margin-bottom: 1rem;
    }

    .work-page .slide-info {
        position: absolute;
        left: 0;
        bottom: 2rem;
        width: 100vw;
        padding: 0 2rem;
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
    }

    .work-page .slide-tags {
        display: flex;
        flex-direction: column;
    }

    .work-page .slide-info-wrapper {
        display: flex;
    }

    .work-page .slide-info-wrapper p {
        text-align: center;
        width: 2rem;
    }

    .work-page .slide-tags p:first-child {
        margin-bottom: 0.5rem;
        font-weight: 700;
        font-size: 1rem;
    }

    .work-page .line, .work-page .word {
        position: relative;
        display: inline-block;
    }

    @media (max-width: 1000px) {
        .work-page h1 {
            font-size: 2rem;
            letter-spacing: 0;
        }

        .work-page p {
            font-size: 0.8rem;
        }

        .work-page .slide-header {
            top: 50%;
            bottom: unset;
            transform: translate(-50%, -50%);
            width: 90%;
        }

        .work-page .slide-description {
            width: 100%;
        }
    }
</style>

<script>
    // @ts-nocheck
    import gsap from "gsap";
    import SplitType from "split-type";

    let sliderEventsController;

    document.addEventListener("astro:before-swap", () => {
        if (sliderEventsController) {
            sliderEventsController.abort();
            sliderEventsController = null;
        }
    });

    document.addEventListener("astro:page-load", () => {
        if (sliderEventsController) {
            sliderEventsController.abort();
            sliderEventsController = null;
        }

        const sliderElement = document.querySelector(".slider");
        if (!sliderElement) return;

        const slides = JSON.parse(sliderElement.dataset.slides);

        sliderEventsController = new AbortController();
        const { signal } = sliderEventsController;

        const totalSlides = slides.length;
        let currentSlide = 1;

        let isAnimating = true;
        let scrollAllowed = false;
        let lastScrollTime = 0;

        const initialSlide = document.querySelector(".slider .slide");

        if (initialSlide) {
            splitText(initialSlide);

            const words = initialSlide.querySelectorAll(".word");
            const lines = initialSlide.querySelectorAll(".line");

            gsap.set([...words, ...lines], { y: "100%", force3D: true });

            const playInitialAnimation = () => {
                const tl = gsap.timeline({
                    onComplete: () => {
                        isAnimating = false;
                        scrollAllowed = true;
                        lastScrollTime = Date.now();
                        preloadAdjacentImages(1);
                    }
                });

                const headerWords = initialSlide.querySelectorAll(".slide-title .word");
                const tagLines = initialSlide.querySelectorAll(".slide-tags .line");
                const indexLines = initialSlide.querySelectorAll(".slide-index-wrapper .line");
                const descriptionLines = initialSlide.querySelectorAll(".slide-description .line");
                const linkLines = initialSlide.querySelectorAll(".slide-link .line");

                tl.to(headerWords, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    stagger: 0.1,
                    force3D: true,
                })
                    .to([tagLines, indexLines, descriptionLines], {
                        y: "0%",
                        duration: 1,
                        ease: "power4.out",
                        stagger: 0.1,
                        force3D: true,
                    }, "-=0.75")
                    .to(linkLines, {
                        y: "0%",
                        duration: 1,
                        ease: "power4.out",
                        force3D: true,
                    }, "-=0.8");
            };

            const overlay = document.getElementById('transition-overlay');
            const isFirstLoad = document.documentElement.classList.contains('is-first-load');
            const isTransitioning = overlay && overlay.style.pointerEvents === 'auto';

            if (isFirstLoad || isTransitioning) {
                window.addEventListener('transition-finished', playInitialAnimation, { once: true });
            } else {
                playInitialAnimation();
            }
        }

        function preloadAdjacentImages(currentIndex) {
            const nextIndex = currentIndex === totalSlides ? 1 : currentIndex + 1;
            const prevIndex = currentIndex === 1 ? totalSlides : currentIndex - 1;

            const nextImg = new Image();
            nextImg.src = slides[nextIndex - 1].slideImg;

            const prevImg = new Image();
            prevImg.src = slides[prevIndex - 1].slideImg;
        }

        function createSlide(slideIndex) {
            const slideData = slides[slideIndex - 1];

            const slide = document.createElement("div");
            slide.className = "slide";

            const slideImg = document.createElement("a");
            slideImg.href = slideData.slideUrl;
            slideImg.className = "slide-img";
            slideImg.setAttribute("data-cursor-text", "Voir le projet");
            const img = document.createElement("img");
            img.src = slideData.slideImg;
            img.alt = `Image de couverture du projet ${slideData.slideTitle}`;
            slideImg.appendChild(img);

            const slideHeader = document.createElement("div");
            slideHeader.className = "slide-header";

            const slideTitle = document.createElement("div");
            slideTitle.className = "slide-title";
            const h1 = document.createElement("h1");
            h1.textContent = slideData.slideTitle;
            slideTitle.appendChild(h1);

            const slideDescription = document.createElement("div");
            slideDescription.className = "slide-description";
            const p = document.createElement("p");
            p.textContent = slideData.slideDescription;
            slideDescription.appendChild(p);

            const slideLink = document.createElement("div");
            slideLink.className = "slide-link";
            const a = document.createElement("a");
            a.href = slideData.slideUrl;
            a.textContent = "Voir le projet";
            slideLink.appendChild(a);

            slideHeader.appendChild(slideTitle);
            slideHeader.appendChild(slideDescription);
            slideHeader.appendChild(slideLink);

            const slideInfo = document.createElement("div");
            slideInfo.className = "slide-info";

            const slideTags = document.createElement("div");
            slideTags.className = "slide-tags";
            const tagsLabel = document.createElement("p");
            tagsLabel.textContent = "Tags";
            slideTags.appendChild(tagsLabel);

            slideData.slideTags.forEach((tag) => {
                const tagP = document.createElement("p");
                tagP.textContent = tag;
                slideTags.appendChild(tagP);
            });

            const slideIndexWrapper = document.createElement("div");
            slideIndexWrapper.className = "slide-index-wrapper";
            const slideIndexCopy = document.createElement("p");
            slideIndexCopy.textContent = slideIndex.toString().padStart(2, "0");
            const slideIndexSeparator = document.createElement("p");
            slideIndexSeparator.textContent = "/";
            const slidesTotalCount = document.createElement("p");
            slidesTotalCount.textContent = totalSlides.toString().padStart(2, "0");

            slideIndexWrapper.appendChild(slideIndexCopy);
            slideIndexWrapper.appendChild(slideIndexSeparator);
            slideIndexWrapper.appendChild(slidesTotalCount);

            slideInfo.appendChild(slideTags);
            slideInfo.appendChild(slideIndexWrapper);

            slide.appendChild(slideImg);
            slide.appendChild(slideHeader);
            slide.appendChild(slideInfo);

            return slide;
        }

        function splitText(slide) {
            const slideHeader = slide.querySelector(".slide-title h1");
            if (slideHeader) {
                new SplitType(slideHeader, { types: 'words' });
            }

            const slideContent = slide.querySelectorAll("p, a:not(.slide-img)");
            slideContent.forEach((element) => {
                new SplitType(element, { types: 'lines' });
            });

            const elementsToMask = slide.querySelectorAll('.word, .line');

            elementsToMask.forEach((el) => {
                const wrapper = document.createElement('div');
                wrapper.style.overflow = 'hidden';
                wrapper.style.display = 'inline-block';
                wrapper.style.verticalAlign = 'top';
                el.parentNode.insertBefore(wrapper, el);
                wrapper.appendChild(el);
            });
        }

        function animateSlide(direction) {
            if (isAnimating || !scrollAllowed) return;

            isAnimating = true;
            scrollAllowed = true;

            const slider = document.querySelector(".slider");
            const currentSlideElement = slider.querySelector(".slide");

            if (direction === "down") {
                currentSlide = currentSlide === totalSlides ? 1 : currentSlide + 1;
            } else {
                currentSlide = currentSlide === 1 ? totalSlides : currentSlide - 1;
            }

            const exitY = direction === "down" ? "-200vh" : "200vh";
            const entryY = direction === "down" ? "100vh" : "-100vh";
            const entryClipPath =
                direction === "down"
                    ? "polygon(20% 20%, 80% 20%, 80% 100%, 20% 100%)"
                    : "polygon(20% 0%, 80% 0%, 80% 80%, 20% 80%)";

            gsap.to(currentSlideElement, {
                scale: 0.25,
                opacity: 0,
                rotation: 30,
                y: exitY,
                duration: 2,
                ease: "power4.inOut",
                force3D: true,
                onComplete: () => {
                    currentSlideElement.remove();
                },
            });

            setTimeout(() => {
                const newSlide = createSlide(currentSlide);

                gsap.set(newSlide, {
                    y: entryY,
                    clipPath: entryClipPath,
                    force3D: true,
                });

                slider.appendChild(newSlide);

                splitText(newSlide);

                document.dispatchEvent(new CustomEvent('dom-updated'));

                const words = newSlide.querySelectorAll(".word");
                const lines = newSlide.querySelectorAll(".line");

                gsap.set([...words, ...lines], {
                    y: "100%",
                    force3D: true,
                });

                const mainTl = gsap.timeline({
                    onComplete: () => {
                        isAnimating = false;
                        setTimeout(() => {
                            scrollAllowed = true;
                            lastScrollTime = Date.now();
                        }, 100);
                        preloadAdjacentImages(currentSlide);
                    }
                });

                mainTl.to(newSlide, {
                    y: 0,
                    clipPath: "polygon(0% 0%, 100% 0%, 100% 100%, 0% 100%)",
                    duration: 1.5,
                    ease: "power4.out",
                    force3D: true,
                });

                const headerWords = newSlide.querySelectorAll(".slide-title .word");
                mainTl.to(headerWords, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    stagger: 0.1,
                    force3D: true,
                }, "<0.75");

                const tagLines = newSlide.querySelectorAll(".slide-tags .line");
                const indexLines = newSlide.querySelectorAll(".slide-index-wrapper .line");
                const descriptionLines = newSlide.querySelectorAll(".slide-description .line");

                mainTl.to(tagLines, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    stagger: 0.1,
                    force3D: true,
                }, "-=0.75");

                mainTl.to(indexLines, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    stagger: 0.1,
                    force3D: true,
                }, "<");

                mainTl.to(descriptionLines, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    stagger: 0.1,
                    force3D: true,
                }, "<");

                const linkLines = newSlide.querySelectorAll(".slide-link .line");
                mainTl.to(linkLines, {
                    y: "0%",
                    duration: 1,
                    ease: "power4.out",
                    force3D: true,
                }, "-=1");

            }, 750);
        }

        function handleScroll(direction) {
            const now = Date.now();
            if (isAnimating || !scrollAllowed) return;
            if (now - lastScrollTime < 1000) return;

            lastScrollTime = now;
            animateSlide(direction);
        }

        window.addEventListener("wheel", (e) => {
            e.preventDefault();
            const direction = e.deltaY > 0 ? "down" : "up";
            handleScroll(direction);
        }, { passive: false, signal });

        let touchStartY = 0;
        let isTouchActive = false;

        window.addEventListener("touchstart", (e) => {
            touchStartY = e.touches[0].clientY;
            isTouchActive = true;
        }, { passive: false, signal });

        window.addEventListener("touchmove", (e) => {
            e.preventDefault();
            if (!isTouchActive || isAnimating || !scrollAllowed) return;

            const touchCurrentY = e.touches[0].clientY;
            const difference = touchStartY - touchCurrentY;

            if (Math.abs(difference) > 50) {
                isTouchActive = false;
                const direction = difference > 0 ? "down" : "up";
                handleScroll(direction);
            }
        }, { passive: false, signal });

        window.addEventListener("touchend", () => {
            isTouchActive = false;
        }, { signal });
    });
</script>