---
import { getCollection } from 'astro:content';
import { getImage } from 'astro:assets';
import Gallery from '../components/Gallery.jsx';
import Layout from "../layouts/Layout.astro";

const allProjects = await getCollection('galleryCollection');

const galleryData = await Promise.all(allProjects.map(async (gallery) => {
    const optimizedThumb = await getImage({ src: gallery.data.coverImage, format: 'webp', width: 800 });
    const optimizedFull = await getImage({ src: gallery.data.coverImage, format: 'webp', width: 2000 });
    
    return {
        id: gallery.id,
        title: gallery.data.title,
        subtitle: gallery.data.subtitle,
        src: optimizedThumb.src,
        fullSrc: optimizedFull.src,
        origWidth: gallery.data.coverImage.width,
        origHeight: gallery.data.coverImage.height,
        description: gallery.body
    };
}));
---

<Layout 
    titre="Galerie & Expérimentations Visuelles — Clément Torchiat" 
    description="Explorez une collection de créations graphiques, posters, expérimentations 3D et explorations visuelles par Clément Torchiat."
    schemaType="CollectionPage"
    breadcrumb={[{ name: "Galerie", path: "/gallery" }]}
    image="/og-image.png"
    imageAlt="Galerie et explorations visuelles de Clément Torchiat"
    masquerFooter={true} 
    typeHeader="alternatif">
    <div class="gallery-wrapper">
        <Gallery client:only="react" projects={galleryData} />
    </div>
</Layout>

<script>
    document.addEventListener('astro:page-load', () => {
        if (document.querySelector('.gallery-wrapper')) {
            document.documentElement.classList.add('no-scroll');
            document.body.classList.add('no-scroll');
        }
    });

    document.addEventListener('astro:before-swap', () => {
        document.documentElement.classList.remove('no-scroll');
        document.body.classList.remove('no-scroll');
    });
</script>

<style is:global>
    html.no-scroll, body.no-scroll {
        overflow: hidden !important;
    }

    .gallery-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
    }
</style>