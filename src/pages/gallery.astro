---
import { getCollection } from 'astro:content';
import Gallery from '../components/Gallery.jsx';
import Layout from "../layouts/Layout.astro";

const allProjects = await getCollection('galleryCollection');

const galleryData = allProjects.map((gallery) => ({
    id: gallery.id,
    title: gallery.data.title,
    subtitle: gallery.data.subtitle,
    src: gallery.data.coverImage.src,
    origWidth: gallery.data.coverImage.width,
    origHeight: gallery.data.coverImage.height,
    description: gallery.body
}));
---

<Layout titre="Galerie - Clément Torchiat" masquerFooter={true} typeHeader="alternatif">
    <div class="gallery-wrapper">
        <Gallery client:only="react" projects={galleryData} />
    </div>
</Layout>

<style is:global>
    body, html {
        overflow: hidden !important;
    }

    .gallery-wrapper {
        position: absolute;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 10;
    }
</style>