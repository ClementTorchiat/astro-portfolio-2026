                    <a
                        data-magnetic
                        data-cursor-hover
                        class="link"
                        href="https://dribbble.com/clement_torchiat"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 16 16"
                            fill="#222222"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M8 0C3.58877 0 0 3.58877 0 8C0 12.4112 3.58877 16 8 16C12.4112 16 16 12.4112 16 8C16 3.58877 12.4112 0 8 0ZM13.2894 3.68923C14.2411 4.852 14.8174 6.333 14.8324 7.94584C14.6071 7.89819 12.348 7.43997 10.0743 7.7259C9.88874 7.27297 9.71361 6.87452 9.47374 6.38352C12.0002 5.352 13.1453 3.8841 13.2894 3.68923ZM12.5297 2.89903C12.4068 3.0741 11.3782 4.45665 8.94839 5.36739C7.82864 3.3101 6.58758 1.62003 6.39871 1.36713C8.56568 0.844774 10.8492 1.4081 12.5297 2.89903ZM5.09487 1.82645C5.27503 2.07352 6.4961 3.76568 7.62832 5.77835C4.43197 6.62716 1.61671 6.61494 1.3111 6.6109C1.75419 4.49048 3.18316 2.72816 5.09487 1.82645ZM1.16677 8.01042C1.16677 7.94055 1.16816 7.871 1.17026 7.80161C1.46923 7.80774 4.78058 7.85042 8.19303 6.82916C8.38865 7.212 8.57552 7.60061 8.74703 7.98881C6.2761 8.68477 4.0311 10.6832 2.92345 12.5793C1.83206 11.3679 1.16677 9.76548 1.16677 8.01042ZM3.80571 13.4012C4.51948 11.942 6.45661 10.0585 9.21148 9.11871C10.1708 11.6117 10.5676 13.7011 10.6692 14.3006C8.47203 15.2365 5.83 14.9797 3.80571 13.4012ZM11.818 13.675C11.7479 13.2593 11.3842 11.259 10.4905 8.80297C12.6318 8.46019 14.5131 9.02129 14.7468 9.09506C14.4423 10.9964 13.3509 12.6384 11.818 13.675Z"
