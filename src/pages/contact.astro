                        class="link"
                        href="https://www.linkedin.com/in/cl%C3%A9ment-torchiat-1965b71bb/"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg
                            width="18"
                            height="18"
                            viewBox="0 0 16 16"
                            fill="#222222"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <path
                                d="M3.58143 16H0.264286V5.31762H3.58143V16ZM1.92107 3.86044C0.860357 3.86044 0 2.98185 0 1.92111C7.59214e-09 1.4116 0.202398 0.92296 0.562669 0.562681C0.92294 0.202403 1.41157 0 1.92107 0C2.43057 0 2.9192 0.202403 3.27947 0.562681C3.63974 0.92296 3.84214 1.4116 3.84214 1.92111C3.84214 2.98185 2.98143 3.86044 1.92107 3.86044ZM15.9964 16H12.6864V10.7999C12.6864 9.56057 12.6614 7.97125 10.9618 7.97125C9.23714 7.97125 8.97286 9.31771 8.97286 10.7106V16H5.65929V5.31762H8.84071V6.77479H8.88714C9.33 5.93549 10.4118 5.04976 12.0257 5.04976C15.3829 5.04976 16 7.26052 16 10.132V16H15.9964Z"
                            ></path>
                        </svg>
                        <p>LinkedIn</p>
                    </a>
                </div>
            </div>
        </div>

        <div class="contact-info-container">
            <div class="contact-info-left">
                <a data-cursor-hover href="/" aria-label="Retour à l'accueil">
                    <svg
                        xmlns:xlink="http://www.w3.org/1999/xlink"
                        width="25"
                        height="28"
                        viewBox="0 0 25 28"
                        fill="none"
                        xmlns="http://www.w3.org/2000/svg"
                    >
                        <path
                            d="M24.64 11.0481V6.98693L12.32 0L0 6.98693V21.012L12.32 27.9995L24.64 21.012V13.3199L12.32 20.3074L11.1411 19.6389V13.3555L17.0065 10.0286L18.0124 10.5995V14.8068L24.6395 11.0486L24.64 11.0481ZM12.32 22.8024L22.1867 17.2064V19.9095L12.32 25.5055L2.21175 19.7726V8.22959L8.02115 4.9329L10.279 6.2133L4.32026 9.59301V18.2652L12.3195 22.8024H12.32ZM17.0109 7.53682L8.68061 12.2568V18.2436L6.63414 17.0829V10.7753L14.6773 6.2133L10.2214 3.68485L12.32 2.49448L22.1867 8.0905V9.94289L20.2829 11.0211V9.39246L17.0114 7.53682H17.0109Z"
                            fill="#222222"></path>
                    </svg>
                </a>
                <p>Copyright 2026 Clément Torchiat. Tous droits réservés.</p>
            </div>
            <p class="contact-ai-notice">
                Vous n'êtes pas autorisé à utiliser mon travail pour la
                génération par IA.
            </p>
        </div>
    </div>
</Layout>

<script>
    const setupNoScroll = () => {
        if (document.querySelector(".contact-page")) {
            document.documentElement.classList.add("contact-no-scroll");
            document.body.classList.add("contact-no-scroll");
        }
    };

    const cleanupNoScroll = () => {
        document.documentElement.classList.remove("contact-no-scroll");
        document.body.classList.remove("contact-no-scroll");
    };

    document.addEventListener("astro:page-load", setupNoScroll);
    document.addEventListener("astro:before-swap", cleanupNoScroll);
</script>

<style is:global>
    html.contact-no-scroll,
    body.contact-no-scroll {
        overflow: hidden !important;
        height: 100% !important;
        max-height: 100% !important;
    }
</style>

<style>
    .contact-page {
        color: var(--black);
        width: 100%;
        height: 100svh;
        max-height: 100svh;
        overflow: hidden;
        position: relative;
        box-sizing: border-box;
        padding-top: calc(75px + 2vh);
        padding-bottom: clamp(16px, 3vh, 32px);
        padding-left: clamp(20px, 4vw, 48px);
        padding-right: clamp(20px, 4vw, 48px);
        display: flex;
        flex-direction: column;
        justify-content: space-between;
        align-items: center;
    }

    .contact-main {
        width: 100%;
        max-width: 1440px;
        flex: 1;
        min-height: 0;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        gap: clamp(20px, 4vh, 52px);
    }

    .contact-title-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .contact-title-icon {
        width: clamp(22px, 2.5vw, 32px);
        height: clamp(22px, 2.5vw, 32px);
        display: block;
        transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .contact-title-container:hover .contact-title-icon {
        transform: rotate(90deg);
    }

    .contact-title {
        font-family: "Jubilee", serif !important;
        font-weight: 500 !important;
        font-size: clamp(1.4rem, 2.8vw, 2.5rem) !important;
        line-height: 1.15 !important;
        color: var(--black) !important;
        letter-spacing: -0.01em;
        margin: 0 !important;
        padding: 0 !important;
        text-align: center;
    }

    .contact-mail-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact-email {
        display: inline-block;
        max-width: 100%;
        text-decoration: none;
        transition:
            opacity 0.25s ease,
            transform 0.25s ease;
    }

    .contact-email:hover {
        opacity: 0.8;
        transform: scale(1.01);
    }

    .contact-email span {
        font-family: "Voyage", serif;
        font-size: clamp(1.8rem, 6.5vw, 8rem);
        line-height: 1.05;
        color: var(--black);
        text-decoration: underline 3px solid var(--black);
        text-underline-offset: clamp(4px, 0.8vw, 12px);
        letter-spacing: -0.01em;
        white-space: nowrap;
        display: block;
    }

    .contact-links-container {
        width: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }

    .contact-links-row {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        align-items: center;
        gap: clamp(8px, 1.6vw, 20px);
    }

    .link {
        display: flex;
        align-items: center;
        gap: 8px;
        text-decoration: none;
        color: var(--black);
        transition: opacity 0.2s ease;
    }

    .link:hover {
        opacity: 0.75;
    }

    .link:after {
        content: "/";
        margin-left: clamp(8px, 1.6vw, 20px);
        color: var(--black);
        font-family: "Jubilee", serif;
        font-size: clamp(1.1rem, 1.8vw, 1.6rem);
        font-weight: 400;
    }

    .link:last-child:after {
        content: "";
        margin-left: 0;
    }

    .link p {
        font-family: "Jubilee", serif;
        font-weight: 500;
        font-size: clamp(1.1rem, 1.8vw, 1.6rem);
        color: var(--black);
        margin: 0;
        line-height: 1;
    }

    .contact-info-container {
        width: 100%;
        max-width: 1440px;
        border-top: var(--black) 1px solid;
        padding-top: clamp(12px, 2vh, 20px);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
        box-sizing: border-box;
    }

    .contact-info-left {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .contact-info-left p,
    .contact-ai-notice {
        font-size: 12px;
        color: var(--black);
        margin: 0;
        line-height: 1.4;
    }

    @media (min-width: 768px) {
        .contact-page {
            padding-top: calc(90px + 3vh);
        }

        .contact-info-container {
            flex-direction: row;
            justify-content: space-between;
            align-items: center;
            text-align: left;
        }

        .contact-info-left {
            flex-direction: row;
            align-items: center;
            gap: 16px;
        }

        .contact-info-left p,
        .contact-ai-notice {
            font-size: 13px;
        }

        .contact-email span {
            text-decoration: underline 4px solid var(--black);
        }
    }

    @media (min-width: 1200px) {
        .contact-email span {
            text-decoration: underline 5px solid var(--black);
        }

        .contact-info-left p,
        .contact-ai-notice {
            font-size: 14px;
        }
    }
</style>
