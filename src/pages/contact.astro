    <style>
        body {
            height: auto;
            min-height: 0;
        }

        .site-footer {
            color: var(--black);
            text-align: center;
            width: 100%;
            overflow-x: hidden;
            position: relative;
            padding-left: 20px;
            padding-right: 20px;
            padding-bottom: 20px;
            margin-top: 20vh;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            height: 80vh;
        }

        .footer-title {
            padding-top: 42px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .footer-title p {
            margin-top: 6px;
        }

        .footer-mail-container {
            width: 100%;
            margin-top: 32px;
            margin-bottom: 16px;
        }

        .footer-mail-container span {
            font-family: "Voyage", serif;
            font-size: 32px;
            text-decoration: underline 1px solid var(--black);
        }

        .footer-links-1, .footer-links-2 {
            display: flex;
            justify-content: center;
            gap: 8px;
        }

        .footer-links-1 {
            margin-bottom: 4px;
        }

        .link {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .link:after {
            content: "/";
        }

        .link:last-child:after {
            content: "";
        }

        .link p {
            font-family: 'Jubilee', serif;
            font-weight: 500;
            font-size: 20px;
            margin: 0;
        }

        .footer-info-container {
            border-top: var(--black) 1px solid;
            margin-top: 48px;
            padding-top: 24px;
            text-align: left;
            display: flex;
            flex-direction: column;
        }

        .footer-info-left {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }

        .footer-info-left p, .footer-info-container p {
            font-size: 12px;
        }

        @media (min-width: 1024px) {
            .site-footer {
                padding-left: 30px;
                padding-right: 30px;
                padding-bottom: 30px;
                margin-top: 20vh;
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                height: 80vh;
            }

            .footer-mail-container {
                margin-top: 94px;
                margin-bottom: 62px;
            }

            .footer-mail-container span {
                font-size: 96px;
                line-height: 1;
                text-decoration: underline 4px solid var(--black);
            }

            .footer-links-container {
                display: flex;
                flex-direction: row;
                justify-items: center;
                align-items: center;
                width: fit-content;
                margin: 0 auto;
                gap: 8px;
            }

            .footer-links-1 {
                margin-bottom: 0;
            }

            .footer-links-1 .link:last-child:after {
                content: "/";
            }

            .footer-links-2 .link:last-child:after {
                content: "";
            }

            .link:hover {
                text-decoration: underline;
            }

            .footer-info-container {
                margin-top: 87px;
                padding-top: 16px;
                flex-direction: row;
                justify-content: space-between;
                align-items: center;
            }

            .footer-info-left {
                flex-direction: row;
                align-items: center;
                gap: 16px;
            }

            .footer-info-left p, .footer-info-container p {
                font-size: 14px;
            }
        }
    </style>
</Layout>