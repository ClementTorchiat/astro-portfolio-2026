---
import Layout from "../layouts/Layout.astro";
---

<Layout
    titre="Contact — Clément Torchiat | Parlons de votre projet"
    description="Vous souhaitez collaborer sur un projet de direction artistique, design d'interface ou développement web ? Entrons en contact avec Clément Torchiat."
    schemaType="ContactPage"
    breadcrumb={[{ name: "Contact", path: "/contact" }]}
    image="/og-image.png"
    imageAlt="Contacter Clément Torchiat — Directeur Artistique & Développeur Web"
    masquerFooter={true}
    typeHeader="alternatif"
>
    <div class="contact-page">
        <div class="contact-main">
            <div class="contact-title-container">
                <svg
                    class="contact-title-icon"
                    width="26"
                    height="26"
                    viewBox="0 0 18 18"
                    fill="none"
                    xmlns="http://www.w3.org/2000/svg"
