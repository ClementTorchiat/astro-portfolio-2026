                        fill="#222222"></path>
                </svg>
                <h1 class="contact-title">Entrons en contact</h1>
            </div>

            <div class="contact-mail-container">
                <a
                    data-cursor-hover
                    href="mailto:clement.torchiat@gmail.com"
                    class="contact-email"
                >
                    <span>clement.torchiat@gmail.com</span>
                </a>
            </div>

            <div class="contact-links-container">
                <div class="contact-links-row">
                    <a
                        data-magnetic
                        data-cursor-hover
                        class="link"
                        href="https://github.com/ClementTorchiat"
                        target="_blank"
                        rel="noopener noreferrer"
                    >
                        <svg
                            width="20"
                            height="19"
                            viewBox="0 0 18 17"
                            fill="#222222"
                            xmlns="http://www.w3.org/2000/svg"
