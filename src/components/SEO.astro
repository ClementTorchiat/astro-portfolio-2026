---
interface BreadcrumbItem {
  name: string;
  path: string;
}

interface ProjectData {
  title: string;
  description: string;
  clientName?: string;
  clientCompany?: string;
  year?: number;
  tags?: string[];
  link?: string;
}

interface Props {
  titre: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  article?: boolean;
  publishedTime?: string | Date;
  tags?: string[];
  noindex?: boolean;
  schemaType?:
    | "WebPage"
    | "WebSite"
    | "AboutPage"
    | "ContactPage"
    | "CollectionPage"
    | "CreativeWork";
  breadcrumb?: BreadcrumbItem[];
  projectData?: ProjectData;
}

const siteUrl = Astro.site
  ? Astro.site.href.replace(/\/$/, "")
  : "https://clement-torchiat.fr";
const canonicalURL = new URL(Astro.url.pathname, siteUrl).href;

const {
  titre,
  description = "Clément Torchiat — Directeur Artistique, UX/UI Designer & Développeur Web. Conception d'expériences digitales créatives, immersives et sur-mesure.",
  image = "/og-image.png",
  imageAlt = titre,
  article = false,
  publishedTime,
  tags = [
    "Clément Torchiat",
    "Directeur Artistique",
    "UX UI Designer",
    "Développeur Web",
    "Creative Developer",
    "Front-End",
    "Astro",
    "React",
    "GSAP",
    "Design Graphique",
    "Portfolio 2026",
  ],
  noindex = false,
  schemaType = "WebPage",
  breadcrumb = [],
  projectData,
} = Astro.props;

// Résolution de l'URL absolue de l'image
const ogImageUrl =
  image.startsWith("http://") || image.startsWith("https://")
    ? image
    : new URL(image.startsWith("/") ? image : `/${image}`, siteUrl).href;

const defaultKeywords = tags.join(", ");

// Construction du fil d'Ariane Schema.org
const breadcrumbItems = [{ name: "Accueil", path: "/" }, ...breadcrumb];

const breadcrumbSchema = {
  "@type": "BreadcrumbList",
  "@id": `${canonicalURL}#breadcrumb`,
  itemListElement: breadcrumbItems.map((item, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: item.name,
    item: new URL(item.path, siteUrl).href,
  })),
};

// Schéma Person (Clément Torchiat)
const personSchema = {
  "@type": "Person",
  "@id": `${siteUrl}/#person`,
  name: "Clément Torchiat",
  alternateName: ["Clem", "Clement Torchiat"],
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  email: "mailto:clement.torchiat@gmail.com",
  jobTitle: ["Directeur Artistique", "UX/UI Designer", "Développeur Web"],
  description:
    "Directeur artistique, designer d'interfaces et ingénieur web créatif.",
  sameAs: [
    "https://www.linkedin.com/in/cl%C3%A9ment-torchiat-1965b71bb/",
    "https://github.com/ClementTorchiat",
    "https://www.behance.net/clementtorchiat",
    "https://dribbble.com/clement_torchiat",
  ],
  knowsAbout: [
    "Direction Artistique",
    "UI/UX Design",
    "Développement Web Front-End",
    "Architecture Web Moderne",
    "Astro",
    "React",
    "GSAP & Animations Web",
    "Motion Design",
    "Design System",
  ],
};

// Schéma WebSite
const websiteSchema = {
  "@type": "WebSite",
  "@id": `${siteUrl}/#website`,
  url: siteUrl,
  name: "Clément Torchiat — Portfolio",
  description:
    "Portfolio officiel de Clément Torchiat : Directeur Artistique, UX/UI Designer & Développeur Web.",
  publisher: { "@id": `${siteUrl}/#person` },
  inLanguage: "fr-FR",
};

// Schéma WebPage ou dérivé
const webPageSchema: Record<string, any> = {
  "@type": schemaType,
  "@id": `${canonicalURL}#webpage`,
  url: canonicalURL,
  name: titre,
  description: description,
  isPartOf: { "@id": `${siteUrl}/#website` },
  about: { "@id": `${siteUrl}/#person` },
  inLanguage: "fr-FR",
  breadcrumb: { "@id": `${canonicalURL}#breadcrumb` },
};

// Graph JSON-LD complet
const jsonLdGraph: any[] = [
  personSchema,
  websiteSchema,
  webPageSchema,
  breadcrumbSchema,
];

// Schéma CreativeWork si projet
if (projectData) {
  jsonLdGraph.push({
    "@type": "CreativeWork",
    "@id": `${canonicalURL}#project`,
    headline: projectData.title,
    name: projectData.title,
    description: projectData.description,
    creator: { "@id": `${siteUrl}/#person` },
    image: ogImageUrl,
    dateCreated: projectData.year ? String(projectData.year) : undefined,
    keywords: projectData.tags ? projectData.tags.join(", ") : undefined,
    url: canonicalURL,
    mainEntityOfPage: canonicalURL,
    ...(projectData.link ? { sameAs: projectData.link } : {}),
  });
}
---

<!-- Métadonnées Primaires Standard -->
<title>{titre}</title>
<meta name="title" content={titre} />
<meta name="description" content={description} />
<meta name="author" content="Clément Torchiat" />
<meta name="creator" content="Clément Torchiat" />
<meta name="publisher" content="Clément Torchiat" />
<meta name="keywords" content={defaultKeywords} />
<link rel="canonical" href={canonicalURL} />

<!-- Indexation & Robots -->
{
  noindex ? (
    <meta name="robots" content="noindex, nofollow" />
  ) : (
    <>
      <meta
        name="robots"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
      <meta
        name="googlebot"
        content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
      />
    </>
  )
}

<!-- Open Graph / Facebook / LinkedIn / Discord / WhatsApp -->
<meta property="og:site_name" content="Clément Torchiat — Portfolio" />
<meta property="og:type" content={article ? "article" : "website"} />
<meta property="og:title" content={titre} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:locale" content="fr_FR" />
<meta property="og:image" content={ogImageUrl} />
<meta property="og:image:secure_url" content={ogImageUrl} />
<meta property="og:image:alt" content={imageAlt} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />

{
  article && (
    <>
      <meta property="article:author" content="Clément Torchiat" />
      <meta property="article:section" content="Design & Développement Web" />
      {publishedTime && (
        <meta
          property="article:published_time"
          content={
            typeof publishedTime === "string"
              ? publishedTime
              : publishedTime.toISOString()
          }
        />
      )}
      {tags.map((tag) => (
        <meta property="article:tag" content={tag} />
      ))}
    </>
  )
}

<!-- Twitter / X Cards -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={titre} />
<meta name="twitter:description" content={description} />
<meta name="twitter:url" content={canonicalURL} />
<meta name="twitter:image" content={ogImageUrl} />
<meta name="twitter:image:alt" content={imageAlt} />

<!-- Mobile, PWA & Thématique Navigateur -->
<meta name="theme-color" content="#F1EADE" />
<meta name="msapplication-TileColor" content="#F1EADE" />
<meta name="apple-mobile-web-app-title" content="Clément Torchiat" />
<meta name="mobile-web-app-capable" content="yes" />
<meta name="apple-mobile-web-app-status-bar-style" content="default" />
<meta name="format-detection" content="telephone=no" />

<!-- Favicons & Manifest -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />
<link rel="sitemap" href="/sitemap-index.xml" />

<!-- Données Structurées JSON-LD Schema.org (@graph) -->
<script
  type="application/ld+json"
  set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@graph": jsonLdGraph,
  })}
/>
