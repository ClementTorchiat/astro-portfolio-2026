---

<script is:inline>
    if (!sessionStorage.getItem('introPlayed')) {
        document.documentElement.classList.add('is-first-load');
    }
</script>

<div id="transition-overlay" transition:persist>
    <div class="panel"></div>
    <div class="panel"></div>
    <div class="panel"></div>
    <div class="panel"></div>

    <div class="text-container">
        <div class="word-mask"><span class="word">Clément</span></div>
        <div class="word-mask"><span class="word">Torchiat</span></div>
    </div>
</div>

<style>
    #transition-overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100vw;
        height: 100vh;
        z-index: 9999;
        pointer-events: none;
        display: flex;
        flex-direction: column;
    }

    .panel {
        width: 100%;
        height: 25vh;
        background-color: #8b684f;
        transform: translateX(-100%);
    }

    .text-container {
        position: absolute;
        top: 50%;
        left: 50%;
        transform: translate(-50%, -50%);
        display: flex;
        gap: 0.5rem;
        font-size: 3rem;
        font-family: serif;
        color: #1A1A1A;
    }

    .word-mask { overflow: hidden; }
    .word {
        display: inline-block;
        transform: translateY(100%);
        color: var(--white);
    }

    html.is-first-load #transition-overlay {
        pointer-events: auto;
    }
    html.is-first-load .panel {
        transform: translateX(0%);
    }
    html.is-first-load .word {
        transform: translateY(0%);
    }
</style>

<script>
    import gsap from 'gsap';
    import { navigate } from 'astro:transitions/client';

    let isTransitionListenerBound = false;

    document.addEventListener('astro:page-load', () => {

        if (document.documentElement.classList.contains('is-first-load')) {
            const introTl = gsap.timeline();

            introTl
                .to({}, { duration: 0.8 })
                .to('.word', {
                    y: '100%',
                    duration: 0.4,
                    stagger: 0.1,
                    ease: 'power2.in'
                })
                .to('.panel', {
                    x: '100%',
                    duration: 1,
                    stagger: 0.075,
                    ease: 'power3.out'
                })
                .set('.panel', { x: '-100%' })
                .set('#transition-overlay', { pointerEvents: 'none' })
                .call(() => {
                    document.documentElement.classList.remove('is-first-load');
                    sessionStorage.setItem('introPlayed', 'true');
                });
        }

        if (!isTransitionListenerBound) {
            document.addEventListener('click', (e) => {
                const target = e.target as HTMLElement;
                if (!target || typeof target.closest !== 'function') return;

                const link = target.closest('a[href^="/"]');
                if (!link) return;

                if (e.ctrlKey || e.metaKey || (link as HTMLAnchorElement).target === '_blank') return;

                e.preventDefault();
                e.stopPropagation();

                const targetUrl = (link as HTMLAnchorElement).href;

                document.getElementById('transition-overlay').style.pointerEvents = 'auto';

                const tl = gsap.timeline();

                tl.to('.panel', {
                    x: '0%',
                    duration: 1,
                    stagger: 0.075,
                    ease: 'power3.in'
                })
                    .to('.word', {
                        y: '0%',
                        duration: 0.4,
                        stagger: 0.1,
                        ease: 'power2.in'
                    })
                    .to({}, { duration: 0.5 })
                    .to('.word', {
                        y: '100%',
                        duration: 0.4,
                        stagger: 0.1,
                        ease: 'power2.in'
                    })
                    .call(() => {
                        navigate(targetUrl);
                    })
                    .to('.panel', {
                        x: '100%',
                        duration: 1,
                        stagger: 0.075,
                        ease: 'power3.out'
                    })
                    .set('.panel', { x: '-100%' })
                    .set('#transition-overlay', { pointerEvents: 'none' });
            }, { capture: true });

            isTransitionListenerBound = true;
        }
    });
</script>